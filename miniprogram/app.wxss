/* 本地记录版：纸白、松墨、细线。字号与触摸区域兼顾年长使用者。 */
page {
  --c-bg: #F6F7F3;
  --c-card: #FFFFFF;
  --c-ink: #252E29;
  --c-ink-2: #68736B;
  --c-ink-3: #68736B;
  --c-primary: #344F42;
  --c-primary-deep: #283E33;
  --c-primary-weak: #EAF0E9;
  --c-success: #344F42;
  --c-warn: #8C6932;
  --c-danger: #A13D36;
  --c-border: #E3E8E0;
  --c-track: #EDF0E9;
  --c-led: #252E29;
  --c-hero-1: #344F42;
  --c-hero-2: #344F42;
  --c-hero-text: #FFFFFF;
  --c-hero-num: #FFFFFF;
  --c-hero-sub: #DBE5DB;
  --fs-hero: 124rpx;
  --fs-big: 64rpx;
  --fs-title: 40rpx;
  --fs-body: 32rpx;
  --fs-small: 28rpx;
  --fs-mini: 24rpx;
  --btn-height: 96rpx;
  --radius: 24rpx;
  --radius-sm: 16rpx;
  --space: 28rpx;
  --page-x: 32rpx;
  background: var(--c-bg);
  color: var(--c-ink);
  font-size: var(--fs-body);
  line-height: 1.6;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}
view, button, input, picker, scroll-view { box-sizing: border-box; }
button { margin: 0; padding: 0 28rpx; }
button::after { border: none; }
input { min-height: 80rpx; color: var(--c-ink); }
.page { padding: 28rpx var(--page-x) calc(40rpx + env(safe-area-inset-bottom)); }
.page-heading { margin: 8rpx 0 32rpx; }
.eyebrow { color: var(--c-ink-2); font-size: 26rpx; letter-spacing: 2rpx; }
.page-title { font-size: 48rpx; font-weight: 600; letter-spacing: 2rpx; margin-top: 8rpx; font-family: 'Songti SC', 'STSong', serif; }
.page-description { color: var(--c-ink-2); font-size: 28rpx; margin-top: 12rpx; }
.card { background: var(--c-card); border: 1rpx solid var(--c-border); border-radius: var(--radius); padding: 28rpx 32rpx; margin-bottom: var(--space); }
.card-hero { background: var(--c-primary); border-radius: var(--radius); padding: 40rpx 36rpx; color: #fff; margin-bottom: var(--space); }
.section-title { color: var(--c-ink-2); font-size: 28rpx; margin: 32rpx 4rpx 16rpx; font-weight: 500; }
.btn { min-width: 0; height: var(--btn-height); line-height: var(--btn-height); border-radius: var(--radius-sm); font-size: 32rpx; font-weight: 500; text-align: center; white-space: nowrap; }
.btn-primary { background: var(--c-primary); color: #fff; }
.btn-primary:active { background: var(--c-primary-deep); }
.btn-ghost { background: var(--c-primary-weak); color: var(--c-primary); }
.btn-plain { background: var(--c-card); color: var(--c-ink); border: 1rpx solid var(--c-border); }
.btn-danger { background: #F8EEEB; color: var(--c-danger); }
.btn[disabled] { color: var(--c-ink-3); background: var(--c-track); opacity: 0.7; }
.btn-row { display: flex; gap: 20rpx; }
.btn-row .btn { flex: 1; width: 0; }
.row { display: flex; align-items: center; min-height: 112rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--c-border); }
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 32rpx; font-weight: 500; overflow-wrap: break-word; }
.row-sub { font-size: 26rpx; color: var(--c-ink-2); margin-top: 6rpx; }
.row-arrow { color: var(--c-ink-3); font-size: 36rpx; margin-left: 20rpx; flex-shrink: 0; }
.row-right { margin-left: 20rpx; color: var(--c-ink-2); font-size: 28rpx; }
.sheet-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(25,35,29,.38); z-index: 90; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 91; background: var(--c-card); border-radius: 28rpx 28rpx 0 0; padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); max-height: 90vh; overflow-y: auto; }
.sheet-title { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; padding-right: 68rpx; }
.sheet-sub { font-size: 28rpx; color: var(--c-ink-2); margin-bottom: 28rpx; padding-right: 48rpx; }
.sheet-close { position: absolute; right: 20rpx; top: 24rpx; width: 80rpx; height: 80rpx; line-height: 80rpx; text-align: center; font-size: 36rpx; color: var(--c-ink-2); }
.progress { height: 8rpx; border-radius: 4rpx; background: var(--c-track); overflow: hidden; }
.progress-fill { height: 100%; border-radius: 4rpx; background: var(--c-primary); }
.seg { display: flex; background: var(--c-track); border-radius: 16rpx; padding: 6rpx; }
.seg-item { flex: 1; text-align: center; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; font-size: 28rpx; color: var(--c-ink-2); }
.seg-item.on { background: var(--c-card); color: var(--c-primary); font-weight: 600; }
.chips { display: flex; gap: 16rpx; flex-wrap: wrap; }
.chip { min-width: 144rpx; min-height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 14rpx; background: var(--c-track); color: var(--c-ink); font-size: 30rpx; padding: 0 24rpx; }
.chip.on { background: var(--c-primary); color: #fff; font-weight: 500; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 88rpx 24rpx; text-align: center; }
.empty-title { font-size: 38rpx; font-weight: 500; margin-bottom: 16rpx; }
.empty-sub { font-size: 30rpx; color: var(--c-ink-2); margin-bottom: 40rpx; line-height: 1.8; }
.badge { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; background: var(--c-track); color: var(--c-ink-2); }
.badge-primary { background: var(--c-primary-weak); color: var(--c-primary); }
.note { font-size: 26rpx; color: var(--c-ink-2); line-height: 1.8; margin: 24rpx 4rpx; }
