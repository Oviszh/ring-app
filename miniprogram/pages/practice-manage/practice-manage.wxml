<!-- P4 功课管理：↑ ↓ 调整顺序，开关控制首页是否显示 -->
<view class="page">

  <view class="section-title">调整顺序 · 控制首页显示</view>

  <view class="card" wx:if="{{rows.length}}">
    <view class="row" wx:for="{{rows}}" wx:key="id">
      <view class="order">
        <view
          class="order-btn {{item.isFirst ? 'off' : ''}}"
          data-index="{{index}}"
          bindtap="onMoveUp"
          hover-class="order-btn-hover"
        >↑</view>
        <view
          class="order-btn {{item.isLast ? 'off' : ''}}"
          data-index="{{index}}"
          bindtap="onMoveDown"
          hover-class="order-btn-hover"
        >↓</view>
      </view>

      <view class="row-main tap" data-id="{{item.id}}" bindtap="onOpenSettings" hover-class="tap-hover">
        <view class="row-title">{{item.name}}</view>
        <view class="row-sub">点此修改功课设置</view>
      </view>

      <switch
        class="switch"
        checked="{{item.showOnHome}}"
        color="#C05B2A"
        data-id="{{item.id}}"
        bindchange="onToggleShow"
      />
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-title">还没有功课</view>
    <view class="empty-sub">添加一个常修的功课，开始今天的修行</view>
  </view>

  <button class="btn btn-ghost add-btn" bindtap="onAdd">＋ 添加功课</button>
</view>
