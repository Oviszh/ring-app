/* P4 功课管理 —— 基于 app.wxss 设计系统 */

/* —— 排序小圆钮 —— */
.order {
  flex: none;
  display: flex;
  gap: 12rpx;
  margin-right: 24rpx;
}

.order-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--c-ink);
  background: var(--c-track);
  border-radius: 50%;
}

.order-btn.off {
  color: var(--c-ink-3);
  opacity: 0.5;
}

.order-btn-hover { background: var(--c-border); }

/* —— 功课名 —— */
.tap {
  padding: 8rpx 0;
  border-radius: 12rpx;
}
.tap-hover { background: var(--c-primary-weak); }

.switch {
  flex: none;
  margin-left: 16rpx;
  transform: scale(1.1);
  transform-origin: right center;
}

.add-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 0;
}
