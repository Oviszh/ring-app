/* P4 功课管理 —— 基于 app.wxss 设计系统 */

/* —— 排序小圆钮 —— */
.order {
  flex: none;
  display: flex;
  gap: 12rpx;
  margin-right: 24rpx;
}

.order-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--c-ink);
  background: var(--c-track);
  border-radius: 50%;
}

.order-btn.off {
  color: var(--c-ink-3);
  opacity: 0.5;
}

.order-btn-hover { background: var(--c-border); }

/* —— 功课名 —— */
.tap {
  padding: 8rpx 0;
  border-radius: 12rpx;
}
.tap-hover { background: var(--c-primary-weak); }

.row .delete-practice { flex: none; width: auto; min-width: 96rpx; min-height: 80rpx; line-height: 80rpx; margin: 0 0 0 16rpx; padding: 0 16rpx; background: transparent; color: var(--c-danger); font-size: 28rpx; }

.add-btn {
  width: 100%;
  margin-top: 8rpx;
  padding: 0;
}
.group-picker { display: inline-block; margin-top: 8rpx; }
.group-choice { min-height: 72rpx; line-height: 72rpx; padding: 0 16rpx; background: var(--c-primary-weak); color: var(--c-primary); font-size: 26rpx; border-radius: 12rpx; }
.order { flex-direction: column; gap: 8rpx; margin-right: 18rpx; }
