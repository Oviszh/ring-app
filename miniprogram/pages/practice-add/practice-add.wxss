/* P5 添加功课 —— 基于 app.wxss 设计系统 */

/* —— 搜索框：浅底、无边框、大圆角 —— */
.search {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx;
  margin-bottom: var(--space);
  background: var(--c-track);
  border-radius: 48rpx;
}

.search-icon {
  flex: none;
  margin-right: 16rpx;
  font-size: 36rpx;
  color: var(--c-ink-3);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: var(--fs-body);
  color: var(--c-ink);
}

.search-ph { color: var(--c-ink-3); }

.search-clear {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--c-ink-2);
  border-radius: 50%;
}

/* —— 结果与自建 —— */
.row-hover { background: var(--c-primary-weak); }

.row-off .row-title { color: var(--c-ink-2); }
.row-off { opacity: 0.7; }

.primary { color: var(--c-primary); }

.badge { display: inline-block; }

/* —— 自建弹层 —— */
.sheet-actions {
  margin-top: 32rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 2rpx solid var(--c-border);
}

.field-label {
  width: 180rpx;
  flex: none;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

.field-value {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 500;
}

.field-arrow {
  color: var(--c-ink-3);
  font-size: var(--fs-body);
}

.field-input {
  flex: 1;
  font-size: var(--fs-body);
}

.field-ph { color: var(--c-ink-3); }

.custom-create { width: 100%; margin: 24rpx 0; }.search { border-radius: 16rpx; background: #fff; border: 1rpx solid var(--c-border); }.field-input { min-width: 0; }.field-label { width: 160rpx; }

.row-main { min-width: 0; }
.practice-description { white-space: normal; overflow-wrap: break-word; line-height: 1.65; }
.practice-tibetan { font-family: 'Kailasa', 'Noto Sans Tibetan', 'Microsoft Himalaya', sans-serif; font-size: 30rpx; line-height: 1.9; color: var(--c-ink-2); margin-top: 10rpx; overflow-wrap: break-word; }
.catalog-categories { margin: 4rpx 0 20rpx; width: 100%; }
.category-track { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; padding-bottom: 8rpx; }
.catalog-category { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 80rpx; padding: 0 12rpx; border: 1rpx solid var(--c-border); border-radius: 40rpx; font-size: 28rpx; color: var(--c-ink-2); background: var(--c-card); }
.catalog-category.on { color: #fff; border-color: var(--c-primary); background: var(--c-primary); font-weight: 500; }
.catalog-section { display: flex; align-items: center; justify-content: space-between; }
.catalog-count { font-size: 24rpx; color: var(--c-ink-2); }
.row .row-arrow, .row .badge { flex-shrink: 0; }
