/* P5 添加功课：大字号、大点击区（老年用户） */
.page {
  padding: var(--space) var(--space) 48rpx;
  box-sizing: border-box;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 20rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.search-icon {
  flex: none;
  margin-right: 16rpx;
  font-size: var(--fs-body);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: var(--fs-body);
  color: var(--c-ink);
}

.search-placeholder {
  color: var(--c-ink-secondary);
}

.search-clear {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--c-ink-secondary);
}

.search-clear-hover {
  background: var(--c-primary-weak);
  border-radius: 50%;
}

.list {
  margin-top: var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  min-height: 140rpx;
  padding: 24rpx var(--space);
  border-bottom: 1rpx solid var(--c-border);
  box-sizing: border-box;
}

.row:last-child {
  border-bottom: none;
}

.row-hover {
  background: var(--c-primary-weak);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.row-alias {
  margin-top: 8rpx;
  font-size: var(--fs-small);
  line-height: 1.5;
  color: var(--c-ink-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-tail {
  flex: none;
  margin-left: 16rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--fs-small);
  line-height: 1.4;
}

.tag-added {
  color: var(--c-ink-secondary);
  background: var(--c-border);
}

.tag-time {
  color: var(--c-primary);
  background: var(--c-primary-weak);
}

.row-disabled {
  background: var(--c-bg);
}

.row-disabled .row-name {
  color: var(--c-ink-secondary);
}

.row-disabled .row-alias {
  opacity: 0.7;
}

.create-row {
  display: flex;
  align-items: center;
  min-height: 140rpx;
  padding: 24rpx var(--space);
  box-sizing: border-box;
}

.create-plus {
  flex: none;
  margin-right: 20rpx;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-primary);
}

.create-name {
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.4;
  color: var(--c-primary);
  word-break: break-all;
}

.create-sub {
  margin-top: 8rpx;
  font-size: var(--fs-small);
  line-height: 1.5;
  color: var(--c-ink-secondary);
}

.empty-hint {
  padding: 120rpx 0;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}
