/* P12-A 单枚戒指页 */

.hero {
  padding: 44rpx 36rpx 36rpx;
}

.hero-name {
  font-size: var(--fs-big);
  font-weight: 600;
  line-height: 1.3;
}

.hero-meta {
  margin-top: 10rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.badge-warn {
  background: #FBEEE2;
  color: var(--c-warn);
}

.hero-sync {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--c-border);
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.btn-block {
  width: 100%;
  margin: 0 0 var(--space);
}

/* —— 功课列表 —— */
.list-card {
  padding: 4rpx 32rpx 8rpx;
}

.hint {
  font-size: var(--fs-mini);
  color: var(--c-ink-3);
  padding: 18rpx 0 6rpx;
}

.hint-empty {
  padding-bottom: 20rpx;
}

.row-hover {
  background: var(--c-primary-weak);
}

.row-action {
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--c-primary);
}

/* —— 触摸锁定 —— */
.lock-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.lock-row {
  border-bottom: none;
}

.lock-switch {
  transform: scale(1.1);
  transform-origin: right center;
}

/* —— 操作 —— */
.btn-row {
  margin-bottom: var(--space);
}

/* —— 演示卡 —— */
.debug-card {
  background: transparent;
  border: 2rpx dashed var(--c-border);
  box-shadow: none;
}

.debug-title {
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-ink-2);
}

.debug-sub {
  margin: 6rpx 0 26rpx;
  font-size: var(--fs-mini);
  color: var(--c-ink-3);
}

.debug-card .btn {
  height: 92rpx;
  line-height: 92rpx;
}
