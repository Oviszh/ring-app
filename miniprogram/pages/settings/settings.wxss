/* P16 设置：大字号、大点击区（老年用户） */
.page {
  padding: var(--space);
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: var(--space);
  padding: 8rpx var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  overflow: hidden;
}

.card-title {
  padding: 20rpx 0 12rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-ink-secondary);
}

.card-hint {
  padding: 8rpx 0 24rpx;
  font-size: var(--fs-small);
  line-height: 1.5;
  color: var(--c-ink-secondary);
}

.row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--c-border);
  box-sizing: border-box;
}

.row:last-child {
  border-bottom: none;
}

.row-hover {
  background: var(--c-primary-weak);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-label {
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.5;
}

.row-sub {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.row-arrow {
  flex: none;
  margin-left: 16rpx;
  font-size: 44rpx;
  line-height: 1;
  color: var(--c-ink-secondary);
}

.switch {
  flex: none;
  margin-left: 16rpx;
  transform: scale(1.15);
  transform-origin: right center;
}

.switch--disabled {
  opacity: 0.4;
}
