/* P16 设置 —— 基于 app.wxss 设计系统 */

.switch {
  flex: none;
  margin-left: 16rpx;
  transform: scale(1.1);
  transform-origin: right center;
}

/* 未绑定戒指时的灰显 */
.dim { color: var(--c-ink-3); }

.row-right {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--c-primary);
  white-space: nowrap;
}

.note {
  padding: 8rpx 8rpx 0;
  font-size: var(--fs-small);
  line-height: 1.7;
  color: var(--c-ink-2);
}
