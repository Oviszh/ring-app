<!-- P16 设置：计数入口 + 通知/账号/备份/关于入口 -->
<view class="page">
  <view class="card">
    <view class="card-title">计数入口</view>

    <view class="row">
      <view class="row-main">
        <view class="row-label">戒指</view>
        <view class="row-sub">暂未接入</view>
      </view>
      <switch class="switch switch--disabled" checked="{{ringEnabled}}" disabled color="#B4552D" />
    </view>

    <view class="row">
      <view class="row-main">
        <view class="row-label">手机</view>
      </view>
      <switch class="switch" checked="{{phoneEnabled}}" color="#B4552D" bindchange="onPhoneChange" />
    </view>

    <view class="card-hint">全部关闭后为纯填报模式</view>
  </view>

  <view class="card">
    <view class="row row-link" bindtap="onNotifications" hover-class="row-hover">
      <view class="row-label">通知与提醒</view>
      <view class="row-arrow">›</view>
    </view>

    <view class="row row-link" bindtap="onAccount" hover-class="row-hover">
      <view class="row-label">账号与云同步</view>
      <view class="row-arrow">›</view>
    </view>

    <view class="row row-link" bindtap="onBackup" hover-class="row-hover">
      <view class="row-label">数据备份 / 恢复</view>
      <view class="row-arrow">›</view>
    </view>

    <view class="row row-link" bindtap="onAbout" hover-class="row-hover">
      <view class="row-label">关于</view>
      <view class="row-arrow">›</view>
    </view>
  </view>
</view>
