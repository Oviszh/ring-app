<view class="page">
  <view class="section-title">首页计数入口</view>
  <view class="card">
    <view class="row"><view class="row-main"><view class="row-title">设备计数</view><view class="row-sub">在首页查看配套设备的计数</view></view><switch checked="{{ringEnabled}}" color="#344F42" bindchange="onRingChange" /></view>
    <view class="row"><view class="row-main"><view class="row-title">触屏计数</view><view class="row-sub">在屏幕上点按计数或静坐计时</view></view><switch checked="{{phoneEnabled}}" color="#344F42" bindchange="onPhoneChange" /></view>
  </view>
  <view class="mode-note">{{fillOnly ? '当前只用手动填报。随时可重新开启计数入口。' : '两个入口可以独立开关，也可以全部关闭，仅保留手动填报。'}}已有记录和本轮计数会保留。</view>
  <view class="section-title">计数设置</view>
  <view class="card">
    <view class="row" bindtap="onDevices"><view class="row-main"><view class="row-title">我的设备</view><view class="row-sub">绑定、同步与设备管理</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="onPhoneSettings"><view class="row-main"><view class="row-title">触屏计数设置</view><view class="row-sub">音效、震动与计数图案</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="onNotifications"><view class="row-main"><view class="row-title">计时与提醒</view></view><text class="row-arrow">›</text></view>
  </view>
  <view class="section-title">数据与隐私</view><view class="card">
    <view class="row" bindtap="onBackup"><view class="row-main"><view class="row-title">备份与恢复</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="onPrivacy"><view class="row-main"><view class="row-title">隐私与数据说明</view></view><text class="row-arrow">›</text></view>
  </view>
  <view class="card"><view class="row" bindtap="onAbout"><view class="row-main"><view class="row-title">关于念佛计数</view></view><text class="row-right">{{version}}</text><text class="row-arrow">›</text></view></view>
</view>
