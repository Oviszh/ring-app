<!-- P16 设置 -->
<view class="page">

  <view class="section-title">计数入口</view>
  <view class="card">
    <view class="row">
      <view class="row-main">
        <view class="row-title">手机计数入口</view>
        <view class="row-sub">关闭后仍可手动填报</view>
      </view>
      <switch class="switch" checked="{{phoneEnabled}}" color="#A9853C" bindchange="onPhoneChange" />
    </view>

    <view class="row">
      <view class="row-main">
        <view class="row-title">戒指计数入口</view>
        <view class="row-sub">关闭后首页不显示戒指计数；未绑定时计数区显示绑定引导</view>
      </view>
      <switch
        class="switch"
        checked="{{ringEnabled}}"
        color="#A9853C"
        bindchange="onRingChange"
      />
    </view>

    <view class="row" bindtap="onDevices">
      <view class="row-main">
        <view class="row-title">我的设备</view>
        <view class="row-sub">{{hasRing ? '管理已绑定的戒指' : '还没有绑定戒指'}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="section-title">其他</view>
  <view class="card">
    <view class="row" bindtap="onPhoneSettings">
      <view class="row-main">
        <view class="row-title">计数音效与外观</view>
        <view class="row-sub">音效 · 震动 · 外观 · 撤销确认</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onNotifications">
      <view class="row-main">
        <view class="row-title">计时与提醒说明</view>
        <view class="row-sub">仅在小程序前台生效</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onAccount">
      <view class="row-main">
        <view class="row-title">账号与云同步</view>
        <view class="row-sub">登录后可在多台手机间同步</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onBackup">
      <view class="row-main">
        <view class="row-title">数据备份 / 恢复</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="onAbout">
      <view class="row-main">
        <view class="row-title">关于</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="note">手机计时与提醒仅在小程序前台有效，切到后台时暂停，返回后继续。</view>
</view>
