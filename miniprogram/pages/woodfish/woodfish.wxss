/* 木鱼页（P2）—— 基于 app.wxss 设计系统 v2 */

.wf-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部仅放 ⚙；返回与标题用原生导航栏 */
.topbar {
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.gear {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--c-ink-2);
  border-radius: 50%;
}
.gear-hover { background: var(--c-card); }

/* —— 垂直居中主体 —— */
.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

.practice-name {
  font-size: var(--fs-title);
  font-weight: 500;
  letter-spacing: 2rpx;
  text-align: center;
}

.round-number,
.timer {
  margin-top: 20rpx;
  font-size: var(--fs-hero);
  line-height: 1.1;
  font-weight: 200;
  letter-spacing: -1rpx;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
}

.round-label {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.today-line {
  margin-top: 18rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
  text-align: center;
}

/* —— 大圆形触摸区 —— */
.tap-zone {
  margin-top: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tap-circle {
  width: 420rpx;
  height: 420rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--c-card);
  border: 3rpx solid var(--c-primary);
  box-shadow: 0 18rpx 48rpx rgba(192, 91, 42, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 120ms ease-out, background 120ms ease-out;
}
.tap-circle--down {
  transform: scale(0.96);
  background: var(--c-primary-weak);
}

.tap-main {
  font-size: 52rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  color: var(--c-primary);
}
.tap-sub {
  margin-top: 16rpx;
  font-size: var(--fs-small);
  letter-spacing: 6rpx;
  color: var(--c-ink-3);
}

/* —— 音效开关 —— */
.sound-pill {
  margin-top: 36rpx;
  min-height: 108rpx;
  line-height: 104rpx;
  box-sizing: border-box;
  padding: 0 44rpx;
  border-radius: 999rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  color: var(--c-ink-2);
  font-size: var(--fs-small);
}
.sound-pill.on {
  background: var(--c-primary-weak);
  border-color: var(--c-primary-weak);
  color: var(--c-primary);
}

/* —— 计时型 —— */
.timer-action {
  width: 560rpx;
  margin-top: 56rpx;
}
.timer-action .btn { width: 100%; }

/* —— 底部：提醒状态 + 操作 —— */
.foot {
  width: 100%;
  flex-shrink: 0;
}

.reminder-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 4rpx;
}
.reminder-badge {
  font-size: var(--fs-small);
  padding: 14rpx 28rpx;
  text-align: center;
}
.cancel-link {
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  font-size: var(--fs-small);
  color: var(--c-primary);
}

.foreground-note {
  text-align: center;
  font-size: var(--fs-mini);
  color: var(--c-ink-3);
  margin: 8rpx 0 20rpx;
}

.actions { margin-top: 4rpx; }

/* —— 本轮已结束 —— */
.ended { text-align: center; }
.ended-title {
  font-size: var(--fs-title);
  font-weight: 500;
}
.ended-sub {
  margin: 18rpx 0 64rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}
.ended-btn { width: 70%; }

/* —— E1 提醒目标弹层 —— */
.sheet {
  max-height: 88vh;
  overflow-y: auto;
}
.sheet-label {
  margin: 36rpx 4rpx 16rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}
.chips-3 .chip {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
}
.sheet-btn {
  width: 100%;
  margin-top: 44rpx;
}
