.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 var(--space) 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 顶部仅放 ⚙ 占位；返回与标题用原生导航栏 */
.topbar {
  width: 100%;
  height: 72rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.gear {
  font-size: 48rpx;
  line-height: 1;
  padding: 8rpx 12rpx;
  color: var(--c-ink-secondary);
}

.gear-hover {
  opacity: 0.6;
}

.practice-name {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-top: 8rpx;
  text-align: center;
}

.round-number {
  font-size: 160rpx;
  line-height: 1.1;
  font-weight: 700;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
  margin-top: 12rpx;
}

.round-label {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
  text-align: center;
}

.today-line {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
  text-align: center;
  margin: 16rpx 0 24rpx;
}

/* —— 木鱼大触摸区 —— */
.woodfish-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.woodfish {
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: linear-gradient(160deg, var(--c-card) 0%, var(--c-primary-weak) 100%);
  border: 10rpx solid var(--c-primary);
  box-shadow: 0 14rpx 32rpx rgba(43, 38, 32, 0.18), inset 0 0 0 14rpx var(--c-card);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 120ms ease-out;
}

.woodfish.tapping {
  transform: scale(0.94);
}

.woodfish-inner {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 4rpx dashed var(--c-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.woodfish-text {
  font-size: 64rpx;
  font-weight: 600;
  color: var(--c-primary);
  letter-spacing: 8rpx;
}

.tap-hint {
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
  margin-top: 18rpx;
}

/* —— 计时型 —— */
.timer {
  font-size: 150rpx;
  line-height: 1.15;
  font-weight: 700;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
  margin: 28rpx 0 8rpx;
}

.btn-end {
  width: 560rpx;
  margin-top: 40rpx;
}

/* —— 音效占位 / 提醒状态 —— */
.sound-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
}

.sound-item {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
  padding: 8rpx 20rpx;
}

.reminder-line {
  width: 100%;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius);
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: var(--fs-small);
  font-weight: 600;
  text-align: center;
}

/* —— 操作按钮 —— */
.actions {
  width: 100%;
  display: flex;
  margin-top: 32rpx;
}

.btn-ghost {
  flex: 1;
  height: var(--btn-height);
  line-height: var(--btn-height);
  padding: 0;
  margin: 0 8rpx;
  font-size: var(--fs-body);
  color: var(--c-ink);
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: var(--radius);
}

.btn-main {
  width: 100%;
  height: 120rpx;
  line-height: 120rpx;
  padding: 0;
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  background: var(--c-primary);
  border-radius: var(--radius);
}

button::after {
  border: none;
}

/* —— 本轮结束后 —— */
.ended-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.ended-title {
  font-size: var(--fs-title);
  font-weight: 600;
}

.ended-sub {
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
  margin: 20rpx 0 72rpx;
}

.btn-ended {
  width: 70%;
}

/* —— E1 提醒目标弹层 —— */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(31, 27, 22, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx var(--space) 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--c-card);
  border-radius: 32rpx 32rpx 0 0;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
}

.sheet-close {
  font-size: 44rpx;
  line-height: 1;
  color: var(--c-ink-secondary);
  padding: 4rpx 16rpx;
}

.sheet-sub {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
  margin-top: 8rpx;
}

.sheet-divider {
  height: 2rpx;
  background: var(--c-border);
  margin: 20rpx 0;
}

.sheet-label {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
  margin: 16rpx 0 10rpx;
}

.chips {
  display: flex;
}

.chip {
  flex: 1;
  height: 88rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  margin-right: 16rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--c-ink);
  background: var(--c-bg);
  border: 2rpx solid var(--c-border);
  border-radius: 16rpx;
}

.chip:last-child {
  margin-right: 0;
}

.chip.active {
  background: var(--c-primary-weak);
  border-color: var(--c-primary);
  color: var(--c-primary);
  font-weight: 600;
}

.sheet-btn {
  margin-top: 36rpx;
}
