<view class="page wf-page" wx:if="{{ready}}">
  <view class="wf-toolbar"><view class="eyebrow">{{isTime ? '静坐' : '触屏计数'}}</view><button class="settings-link" bindtap="onSettings">计数设置</button></view>
  <view class="stage" wx:if="{{!ended}}">
    <view class="practice-name">{{practiceName}}</view>
    <view class="round-label">{{isTime ? '本座时长' : '本轮计数'}}</view>
    <view class="round-led"><led-number value="{{isTime ? elapsedText : roundText}}" min-digits="{{isTime ? 0 : 6}}" /></view>
    <view class="today-line">{{todayText}}</view>
    <view wx:if="{{isTime}}" class="quiet-stage"><view class="quiet-circle"><view class="quiet-inner"></view></view><view class="quiet-caption">安心静坐</view></view>
    <button wx:else class="tap-zone theme-{{theme}} {{tapping ? 'tap-zone--down' : ''}}" bindtap="onTapWoodfish" hover-class="tap-hover" aria-label="计数加一">
      <view class="tap-art"><view class="art-ring"></view><view class="art-line"></view><view class="art-dot"></view></view><view class="tap-main">轻触计数</view><view class="tap-sub">每次增加 1 {{unit}}</view>
    </button>
    <view wx:if="{{!isTime}}" class="sound-control" bindtap="onSound"><view class="sound-indicator {{sound ? 'on' : ''}}"></view>音效{{sound ? '开启' : '关闭'}}</view>
    <view class="wf-footer"><view wx:if="{{reminderText}}" class="reminder-block"><text>{{reminderText}}</text><view class="cancel-link" bindtap="onCancelReminder">取消提醒</view></view><view class="foreground-note">{{isTime || reminderText ? '保持小程序在前台，计时与提醒才会继续。' : '本轮记录自动保存'}}</view>
      <view wx:if="{{isTime}}" class="btn-row"><button class="btn btn-primary" bindtap="onEndRound">结束静坐</button></view>
    </view>
  </view>
  <view wx:else class="ended-stage"><view class="practice-name">{{practiceName}}</view><view class="ended-title">本次已记录</view><view class="ended-sub">可在日历中查看今日的修行记录。</view><button class="btn btn-primary" bindtap="onStartNewSession">{{isTime ? '再次静坐' : '开始计数'}}</button></view>
</view>
