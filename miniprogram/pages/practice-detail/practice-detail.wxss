/* 功课详情页（P3）—— 基于 app.wxss 设计系统 v2 */

.topbar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 4rpx;
}

.more {
  width: 88rpx;
  height: 88rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--c-ink-2);
  border-radius: 50%;
}
.more-hover { background: var(--c-card); }

/* —— 状态区 —— */
.status-card { padding: 28rpx 32rpx; }
.status-card.is-active { background: var(--c-primary-weak); }
.status-card.is-active .status-reminder .badge { background: var(--c-card); }

.status-text {
  font-size: var(--fs-body);
  font-weight: 500;
  line-height: 1.5;
}

.status-reminder {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.status-reminder .badge {
  padding: 12rpx 20rpx;
  font-size: var(--fs-small);
  text-align: center;
}
.reminder-cancel {
  margin-top: 6rpx;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: var(--fs-small);
  color: var(--c-primary);
}

/* —— 今日累积 —— */
.card-label {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.today-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 4rpx;
}
.today-total {
  font-size: var(--fs-big);
  line-height: 1.15;
  font-weight: 200;
  letter-spacing: 1rpx;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
}
.today-target {
  margin-left: 12rpx;
  font-size: var(--fs-body);
  font-weight: 300;
  color: var(--c-ink-2);
}
.today-unit {
  margin-left: 10rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.today-progress {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
}
.today-progress .progress { flex: 1; }
.today-percent {
  flex-shrink: 0;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
  font-variant-numeric: tabular-nums;
}

.today-breakdown { margin-top: 20rpx; }

/* —— 开启新一轮 —— */
.start-card { padding-bottom: 32rpx; }

.card-title {
  margin-bottom: 4rpx;
  font-size: var(--fs-body);
  font-weight: 600;
}

.start-card .row { padding-left: 4rpx; padding-right: 4rpx; }
.no-border { border-bottom: none; }

.row-hover {
  background: var(--c-primary-weak);
  border-radius: 12rpx;
}

.method {
  font-size: var(--fs-small);
  color: var(--c-primary);
}

.start-btn {
  width: 100%;
  margin-top: 28rpx;
}

/* —— 长期大愿 —— */
.vow { padding-top: 12rpx; }

.vow-head {
  display: flex;
  align-items: center;
}
.vow-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vow-nums {
  margin: 14rpx 0 20rpx;
  font-size: var(--fs-title);
  font-weight: 300;
  letter-spacing: 1rpx;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
}
.vow-slash {
  font-size: var(--fs-small);
  font-weight: 400;
  color: var(--c-ink-2);
}

.vow-meta { margin-top: 16rpx; }

.vow-add {
  margin-top: 8rpx;
  min-height: var(--btn-height);
  line-height: var(--btn-height);
  text-align: center;
  border: 2rpx dashed var(--c-border);
  border-radius: var(--radius-sm);
  color: var(--c-primary);
  font-size: var(--fs-body);
}

/* —— 近 7 日 —— */
.recent-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.recent-legend {
  font-size: var(--fs-mini);
  color: var(--c-ink-3);
}

.days {
  display: flex;
  margin-top: 24rpx;
}
.day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.day-dot {
  font-size: 32rpx;
  line-height: 1.2;
  color: var(--c-ink-3);
}
.day-dot--met { color: var(--c-primary); }
.day-dot--partial { color: var(--c-primary); opacity: 0.5; }
.day-dot--missed { color: var(--c-ink-3); }
.day-dot--none { color: var(--c-border); }

.day-label {
  margin-top: 10rpx;
  font-size: var(--fs-mini);
  color: var(--c-ink-3);
}

/* —— 底部入口 —— */
.footer-links { margin-top: 8rpx; }

/* —— E1 提醒目标弹层 —— */
.sheet {
  max-height: 88vh;
  overflow-y: auto;
}
.sheet-label {
  margin: 36rpx 4rpx 16rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}
.chips-3 .chip {
  flex: 1;
  min-width: 0;
  padding: 0 8rpx;
}
.sheet-btn {
  width: 100%;
  margin-top: 44rpx;
}
