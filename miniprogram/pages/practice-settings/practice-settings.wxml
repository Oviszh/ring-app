<view class="page" wx:if="{{ready}}">
  <view class="card">
    <view class="row">
      <view class="row-label">名称</view>
      <view class="row-value">{{name}}<text wx:if="{{isPublic}}" class="tag">（公共）</text></view>
    </view>

    <view class="row">
      <view class="row-label">我的显示名</view>
      <input
        class="row-input"
        value="{{displayName}}"
        placeholder="{{placeholderName}}"
        placeholder-class="input-placeholder"
        maxlength="30"
        confirm-type="done"
        bindinput="onDisplayNameInput"
        bindblur="onDisplayNameBlur"
        bindconfirm="onDisplayNameConfirm"
      />
    </view>
    <view class="row-note">留空使用功课原名，仅更改显示方式。</view>
  </view>

  <view class="card">
    <view class="row">
      <view class="row-label">每日目标</view>
      <input
        class="row-input row-input--num"
        type="number"
        value="{{dailyTargetInput}}"
        placeholder="无目标"
        placeholder-class="input-placeholder"
        confirm-type="done"
        bindinput="onTargetInput"
        bindblur="onTargetBlur"
        bindconfirm="onTargetConfirm"
      />
      <view class="row-unit">{{unit}}</view>
    </view>
    <view class="row-note">修改立即生效，过去日期仍按当时目标计算</view>
  </view>

  <view class="card">
    <picker
      wx:if="{{!isTime}}"
      value="{{vibrateIndex}}"
      range="{{vibrateOptions}}"
      bindchange="onVibrateChange"
    >
      <view class="row">
        <view class="row-label">震动提醒</view>
        <view class="row-right">{{vibrateLabel}}</view>
        <text class="row-arrow">›</text>
      </view>
    </picker>
    <view wx:if="{{!isTime && showCustomHint}}" class="row-note">当前：每 {{vibrateEvery}} 次震动提醒</view>

    <view class="row">
      <view class="row-label">首页显示</view>
      <switch class="row-switch" checked="{{showOnHome}}" color="#344F42" bindchange="onShowOnHomeChange" />
    </view>

    <view wx:if="{{isTime}}" class="row">
      <view class="row-label">记录方式</view>
      <view class="badge badge-primary lock-badge">仅计时</view>
    </view>
    <view wx:if="{{isTime}}" class="row-note">此功课只记录时长，不使用点按计数。</view>
  </view>

  <view class="section-title">功课分组</view>
  <view class="seg"><view class="seg-item {{group === 'main' ? 'on' : ''}}" data-group="main" bindtap="onGroup">主修功课</view><view class="seg-item {{group === 'common' ? 'on' : ''}}" data-group="common" bindtap="onGroup">常用功课</view></view>
  <view class="row-note">主修功课每天展示；常用功课在日历中有记录时展示。</view>
  <view class="danger-zone">
    <button class="btn btn-danger" bindtap="onDelete">删除功课</button>
    <view class="danger-note">删除不影响历史统计与历史记录</view>
  </view>
</view>
