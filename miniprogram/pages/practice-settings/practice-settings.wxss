/* 功课设置页（P7）—— 基于 app.wxss 设计系统 v2 */

.card picker { display: block; }

.row-label {
  width: 210rpx;
  flex-shrink: 0;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

.row-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

.row .row-right { margin-left: auto; }

.tag {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.row-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  margin-left: 24rpx;
  font-size: var(--fs-body);
  color: var(--c-ink);
  text-align: right;
}

.row-input--num {
  font-variant-numeric: tabular-nums;
}

.input-placeholder {
  color: var(--c-ink-3);
}

.row-unit {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.row-switch {
  margin-left: auto;
  transform: scale(1.1);
  transform-origin: right center;
}

.lock-badge { margin-left: auto; }

/* picker 里的行是唯一子节点，需显式补回分隔线 */
.card picker .row { border-bottom: 2rpx solid var(--c-border); }

.row-note {
  padding: 14rpx 4rpx 20rpx;
  font-size: var(--fs-small);
  line-height: 1.6;
  color: var(--c-ink-2);
}

/* —— 删除 —— */
.danger-zone { margin-top: 48rpx; }

.danger-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}
