<!-- P8 大愿详情：进行中 / 已圆满 -->
<view class="page" wx:if="{{ready}}">

  <view class="page-heading"><view class="eyebrow">长期大愿</view><view class="page-title">{{title}}</view></view>
  <!-- 进行中 -->
  <block wx:if="{{!done}}">
    <!-- 大字进度 -->
    <view class="card hero">
      <view class="hero-nums">
        <text class="hero-now">{{totalText}}</text>
        <text class="hero-sep">/</text>
        <text class="hero-target">{{targetText}}</text>
      </view>
      <view class="hero-unit">{{unit}}</view>

      <view class="progress hero-progress">
        <view class="progress-fill" style="{{barStyle}}"></view>
      </view>
      <view class="hero-pct">{{percent}}%</view>
    </view>

    <!-- 发愿信息 -->
    <view class="card meta-card">
      <view class="row">
        <view class="meta-label">发愿于</view>
        <view class="meta-value">{{startDate}}</view>
      </view>
      <view class="row" wx:if="{{deadline}}">
        <view class="meta-label">期限</view>
        <view class="meta-value">至 {{deadline}}</view>
      </view>
      <view class="row">
        <view class="meta-label">日均</view>
        <view class="meta-value">{{avgText}}</view>
      </view>
      <view class="row">
        <view class="meta-label">预计圆满</view>
        <view class="meta-value">{{etaText}}</view>
      </view>
    </view>

    <!-- 近 30 日 -->
    <view class="card chart-card">
      <view class="chart-head">
        <view class="section-title">近 30 日</view>
        <view class="chart-max" wx:if="{{chartMaxText}}">最高 {{chartMaxText}} {{unit}}</view>
      </view>

      <view class="chart">
        <view wx:for="{{bars}}" wx:key="date" class="chart-col">
          <view class="chart-bar {{item.empty ? 'chart-bar--zero' : ''}}" style="{{item.barStyle}}"></view>
        </view>
      </view>

      <view class="chart-axis">
        <text>{{axisStart}}</text>
        <text>今天</text>
      </view>
    </view>

    <view class="btn-row actions">
      <button class="btn btn-plain" bindtap="goEdit">修改大愿</button>
      <button class="btn btn-danger" bindtap="onDelete">删除大愿</button>
    </view>
  </block>

  <view wx:else class="card done-card">
    <view class="done-emoji">✓</view>
    <view class="done-title">已圆满</view>
    <view class="done-sub">{{totalText}} {{unit}}</view>
    <view class="done-meta">历时 {{days}} 天</view>

    <button class="btn btn-primary done-btn" bindtap="goNewVow">再发新愿</button>
    <view class="btn-row done-actions">
      <button class="btn btn-plain" bindtap="goEdit">修改大愿</button>
      <button class="btn btn-danger" bindtap="onDelete">删除大愿</button>
    </view>
  </view>
</view>
