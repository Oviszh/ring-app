<!-- P8 大愿详情：进行中 / 已圆满 -->
<view class="page" wx:if="{{ready}}">
  <block wx:if="{{!done}}">
    <view class="hero">
      <view class="hero-nums">
        <text class="hero-now">{{totalText}}</text>
        <text class="hero-sep">/</text>
        <text class="hero-target">{{targetText}}</text>
      </view>
      <view class="hero-unit">{{unit}}</view>

      <view class="bar">
        <view class="bar-fill" style="width: {{percent}}%;"></view>
      </view>
      <view class="percent">{{percent}}%</view>
    </view>

    <view class="meta-card">
      <view class="meta-row">
        <text class="meta-label">发愿于</text>
        <text class="meta-value">{{startDate}}</text>
      </view>
      <view class="meta-row" wx:if="{{deadline}}">
        <text class="meta-label">期限</text>
        <text class="meta-value">至 {{deadline}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">进度</text>
        <text class="meta-value">{{dailyText}}</text>
      </view>
    </view>

    <view class="chart-card">
      <view class="chart-head">
        <text class="section-title">近 30 日</text>
        <text class="chart-max" wx:if="{{chartMaxText}}">最高 {{chartMaxText}} {{unit}}</text>
      </view>

      <view class="chart">
        <view wx:for="{{bars}}" wx:key="date" class="chart-col">
          <view
            class="chart-bar {{item.empty ? 'chart-bar--zero' : ''}}"
            style="height: {{item.h}}rpx;"
          ></view>
        </view>
      </view>

      <view class="chart-axis">
        <text>{{axisStart}}</text>
        <text>今天</text>
      </view>
    </view>

    <view class="actions">
      <button class="btn-secondary" bindtap="goEdit">修改大愿</button>
      <button class="btn-danger" bindtap="onDelete">删除大愿</button>
    </view>
  </block>

  <view wx:else class="done-card">
    <view class="done-title">🎉 已圆满</view>
    <view class="done-sub">{{totalText}} {{unit}} · 历时 {{days}} 天</view>
    <button class="btn-primary" bindtap="goNewVow">再发新愿</button>
  </view>
</view>
