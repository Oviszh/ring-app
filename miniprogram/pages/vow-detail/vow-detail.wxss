/* P8 大愿详情 —— 基于 app.wxss 设计系统 v2 */

/* —— 大字进度 —— */
.hero {
  text-align: center;
  padding: 48rpx 32rpx 36rpx;
}

.hero-nums {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
}

.hero-now {
  font-size: var(--fs-big);
  font-weight: 300;
  line-height: 1.15;
  letter-spacing: 1rpx;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.hero-sep {
  margin: 0 12rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-3);
}

.hero-target {
  font-size: var(--fs-body);
  color: var(--c-ink-2);
  font-variant-numeric: tabular-nums;
}

.hero-unit {
  margin-top: 6rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.hero-progress { margin-top: 36rpx; }

.hero-pct {
  margin-top: 14rpx;
  text-align: right;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-primary);
  font-variant-numeric: tabular-nums;
}

/* —— 发愿信息 —— */
.meta-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.meta-label {
  flex: none;
  width: 210rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

.meta-value {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 500;
  text-align: right;
  line-height: 1.5;
}

/* —— 近 30 日柱状图 —— */
.chart-card { padding-bottom: 28rpx; }

.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.chart-head .section-title { margin: 0 0 28rpx 0; }

.chart-max {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 180rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
}

.chart-bar {
  width: 12rpx;
  background: var(--c-primary);
  border-radius: 6rpx 6rpx 2rpx 2rpx;
}

.chart-bar--zero {
  background: var(--c-track);
  border-radius: 2rpx;
}

.chart-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid var(--c-border);
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

/* —— 操作 —— */
.actions { margin-top: 12rpx; }

/* —— 圆满态 —— */
.done-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 40rpx 56rpx;
  margin-top: 40rpx;
}

.done-emoji {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.done-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-success);
}

.done-sub {
  margin-top: 16rpx;
  font-size: var(--fs-big);
  font-weight: 300;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.done-meta {
  margin-top: 8rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.done-btn {
  width: 70%;
  margin-top: 56rpx;
}

.done-actions {
  width: 100%;
  margin-top: 24rpx;
}
