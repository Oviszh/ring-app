/* P8 大愿详情：大字号、大点击区 */
.page {
  padding: var(--space) var(--space) 64rpx;
  box-sizing: border-box;
}

/* —— 进行中 —— */

.hero {
  padding: 40rpx var(--space) var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  text-align: center;
}

.hero-nums {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
}

.hero-now {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--c-primary);
  font-family: "DIN Alternate", "Courier New", monospace;
}

.hero-sep {
  margin: 0 12rpx;
  font-size: 40rpx;
  color: var(--c-ink-secondary);
}

.hero-target {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--c-ink-secondary);
  font-family: "DIN Alternate", "Courier New", monospace;
}

.hero-unit {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.bar {
  height: 20rpx;
  margin-top: 28rpx;
  background: var(--c-primary-weak);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--c-primary);
  border-radius: 999rpx;
}

.percent {
  margin-top: 12rpx;
  text-align: right;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--c-primary);
}

.meta-card {
  margin-top: 20rpx;
  padding: 8rpx var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
}

.meta-row {
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-border);
  box-sizing: border-box;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  width: 150rpx;
  flex: none;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.meta-value {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--c-ink);
}

/* —— 近 30 日柱状图 —— */

.chart-card {
  margin-top: 20rpx;
  padding: var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
}

.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: var(--fs-body);
  font-weight: 600;
}

.chart-max {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 180rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 100%;
}

.chart-bar {
  width: 64%;
  min-height: 2rpx;
  background: var(--c-primary);
  border-radius: 4rpx 4rpx 0 0;
}

.chart-bar--zero {
  min-height: 4rpx;
  background: var(--c-border);
}

.chart-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

/* —— 操作 —— */

.actions {
  display: flex;
  margin-top: 40rpx;
}

.actions .btn-secondary,
.actions .btn-danger {
  flex: 1;
  height: var(--btn-height);
  line-height: var(--btn-height);
  margin: 0;
  padding: 0 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  border-radius: var(--radius);
  text-align: center;
  box-sizing: border-box;
}

.actions .btn-secondary {
  margin-right: 20rpx;
  color: var(--c-primary);
  background: var(--c-card);
  border: 2rpx solid var(--c-primary);
}

.actions .btn-danger {
  color: var(--c-danger);
  background: var(--c-card);
  border: 2rpx solid var(--c-danger);
}

.actions .btn-secondary::after,
.actions .btn-danger::after {
  border: none;
}

/* —— 已圆满 —— */

.done-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
  padding: 80rpx var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
}

.done-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--c-success);
}

.done-sub {
  margin-top: 20rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
  text-align: center;
}

.btn-primary {
  width: 100%;
  height: var(--btn-height);
  line-height: var(--btn-height);
  margin: 64rpx 0 0;
  padding: 0 20rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: #fff;
  background: var(--c-primary);
  border-radius: var(--radius);
  text-align: center;
  box-sizing: border-box;
}

.btn-primary::after {
  border: none;
}

.done-card .btn-primary {
  width: 70%;
}
