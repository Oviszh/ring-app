<!-- P14 大愿列表 -->
<view class="page">

  <block wx:if="{{ready}}">
    <!-- 空态 -->
    <view wx:if="{{!total}}" class="empty">
      <view class="empty-mark">愿</view>
      <view class="empty-title">还没有大愿</view>
      <view class="empty-sub">为一项功课设定长期目标，持续记录进度。</view>
      <button class="btn btn-primary empty-btn" bindtap="goNew">设立长期大愿</button>
    </view>

    <block wx:else>
      <!-- 头部 -->
      <view class="head">
        <view class="head-count">进行中 {{active.length}}</view>
        <view class="head-add" hover-class="head-add-hover" bindtap="goNew">＋ 新建</view>
      </view>

      <!-- 进行中 -->
      <block wx:if="{{active.length}}">
        <view
          wx:for="{{active}}"
          wx:key="id"
          class="card vow-card"
          hover-class="vow-card-hover"
          data-id="{{item.id}}"
          bindtap="goDetail"
        >
          <view class="vow-title">{{item.title}}</view>

          <view class="vow-nums">
            <text class="vow-now">{{item.totalText}}</text>
            <text class="vow-sep">/</text>
            <text class="vow-target">{{item.targetText}}</text>
            <text class="vow-pct">{{item.percent}}%</text>
          </view>

          <view class="progress vow-progress">
            <view class="progress-fill" style="{{item.barStyle}}"></view>
          </view>

          <view class="row-sub">日均 {{item.avgText}} · {{item.etaText}}</view>
        </view>
      </block>

      <view wx:else class="none-active">所有大愿都已圆满，随喜！</view>

      <!-- 已圆满 -->
      <block wx:if="{{done.length}}">
        <view class="section-title">已圆满的大愿</view>
        <view class="card done-card">
          <view
            wx:for="{{done}}"
            wx:key="id"
            class="row"
            hover-class="row-hover"
            data-id="{{item.id}}"
            bindtap="goDetail"
          >
            <text class="done-emoji">✓</text>
            <view class="row-main">
              <view class="row-title">{{item.title}}</view>
              <view class="row-sub">历时 {{item.days}} 天</view>
            </view>
            <text class="row-arrow">›</text>
          </view>
        </view>
      </block>
    </block>
  </block>
</view>
