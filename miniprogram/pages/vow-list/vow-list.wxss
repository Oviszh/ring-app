/* P14 大愿列表：大字号、大点击区 */
.page {
  padding: var(--space) var(--space) 64rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-bottom: 8rpx;
}

.toolbar-count {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.toolbar-add {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-primary);
  background: var(--c-primary-weak);
  border-radius: 999rpx;
}

.toolbar-add-hover {
  opacity: 0.75;
}

.plus {
  margin-right: 8rpx;
  font-size: 40rpx;
  line-height: 1;
}

/* —— 进行中卡片 —— */

.card {
  margin-bottom: 20rpx;
  padding: var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
}

.card-hover {
  background: var(--c-primary-weak);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.nums {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.num-now {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--c-primary);
}

.num-sep {
  margin: 0 8rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.num-target {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  color: var(--c-ink-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.percent {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-primary);
}

.bar {
  height: 16rpx;
  margin-top: 16rpx;
  background: var(--c-primary-weak);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: var(--c-primary);
  border-radius: 999rpx;
}

.meta {
  margin-top: 16rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.none-active {
  padding: 80rpx 0;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

/* —— 已圆满 —— */

.done-section {
  margin-top: 40rpx;
}

.done-head {
  padding: 0 8rpx 12rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-ink);
}

.done-list {
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  overflow: hidden;
}

.done-row {
  display: flex;
  align-items: center;
  min-height: var(--btn-height);
  padding: 20rpx var(--space);
  border-bottom: 1rpx solid var(--c-border);
  box-sizing: border-box;
}

.done-row:last-child {
  border-bottom: none;
}

.done-row-hover {
  background: var(--c-primary-weak);
}

.done-emoji {
  flex: none;
  margin-right: 16rpx;
  font-size: 36rpx;
}

.done-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.done-days {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

/* —— 空态 —— */

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx var(--space);
}

.empty-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-ink-secondary);
  margin-bottom: 64rpx;
  text-align: center;
}

.btn-primary {
  height: var(--btn-height);
  line-height: var(--btn-height);
  margin: 0;
  padding: 0 20rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: #fff;
  background: var(--c-primary);
  border-radius: var(--radius);
  text-align: center;
  box-sizing: border-box;
}

.btn-primary::after {
  border: none;
}

.empty-btn {
  width: 68%;
}

/* 沉静的留白、细分隔与统一操作尺寸。 */
.card,.list { border-color:#E2E5DC; box-shadow:none; }
.btn-main,.btn-primary,.btn-save,.card-btn { border-radius:20rpx; font-weight:500; }
.sheet { max-height:85vh; overflow-y:auto; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-close { min-width:72rpx; min-height:72rpx; text-align:center; line-height:72rpx; }
