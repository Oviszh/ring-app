/* P14 大愿列表 —— 基于 app.wxss 设计系统 v2 */

/* —— 头部 —— */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 4rpx 20rpx;
}

.head-count {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.head-add {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: var(--fs-small);
  font-weight: 600;
}
.head-add-hover { opacity: 0.7; }

/* —— 进行中卡片 —— */
.vow-card {
  padding: 36rpx 32rpx 32rpx;
}
.vow-card-hover { background: #FCFBF9; }

.vow-title {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.vow-nums {
  display: flex;
  align-items: baseline;
  margin-top: 18rpx;
}

.vow-now {
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: 1rpx;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.vow-sep {
  margin: 0 10rpx;
  font-size: var(--fs-title);
  color: var(--c-ink-3);
}

.vow-target {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vow-pct {
  flex: none;
  margin-left: 16rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-primary);
  font-variant-numeric: tabular-nums;
}

.vow-progress { margin-top: 24rpx; }

.none-active {
  padding: 96rpx 0 24rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

/* —— 已圆满 —— */
.done-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.done-emoji {
  flex: none;
  width: 56rpx;
  font-size: 32rpx;
  line-height: 1;
  margin-right: 8rpx;
}

.row-hover { background: #FCFBF9; }

/* —— 空态 —— */
.empty-mark {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-btn { width: 66%; }
