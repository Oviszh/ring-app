<!-- P9 当日详情：来源拆分、补录展开/撤销，点行进修正 -->
<view class="page">
  <view class="day-head">
    <view class="day-head-title">{{dateLabel}}</view>
    <view class="day-head-sub">点击数字修改当日合计，自动补录差额。</view>
  </view>

  <view wx:if="{{empty}}" class="empty">
    <view class="empty-title">当日无记录</view>
    <view class="empty-sub">这一天还没有任何功课数据</view>
  </view>

  <block wx:else>
  <block wx:for="{{groups}}" wx:for-item="group" wx:key="id">
  <view class="section-title day-group-title">{{group.title}}</view>
  <view class="card list-card">
    <view
      wx:for="{{group.rows}}"
      wx:key="id"
      class="item {{item.highlight ? 'on' : ''}}"
    >
      <view class="row" data-id="{{item.id}}" bindtap="onRowTap">
        <view class="row-main">
          <view class="row-title">
            <view class="st st-{{item.statusClass}}"></view>
            <text class="name">{{item.name}}</text>
          </view>
          <view class="row-sub">{{item.sourceText}}</view>
          <view class="row-sub">{{item.groupName}}{{item.isDuration ? ' · 时长按分钟填写' : ''}}{{item.timingActive ? ' · 计时中请先结束本座' : ''}}</view>
          <view
            wx:if="{{item.hasEntries}}"
            class="entry-toggle"
            data-index="{{item.rowIndex}}"
            catchtap="onToggleEntries"
          >
            补录 {{item.entries.length}} 笔
            <text class="toggle-arrow">{{item.expanded ? '收起 ▴' : '展开 ▾'}}</text>
          </view>
        </view>
        <view class="nums">
          <view class="amount">
            <input wx:if="{{item.canEdit}}" class="total-input" type="number" maxlength="16" value="{{item.inputValue}}" data-id="{{item.id}}" catchtap="noop" bindfocus="onTotalFocus" bindinput="onTotalInput" bindblur="onTotalCommit" bindconfirm="onTotalCommit" confirm-type="done" aria-label="{{item.name}}当日合计" />
            <text wx:else>{{item.amountText}}</text>
          </view>
          <view wx:if="{{item.canEdit}}" class="edit-caption">{{item.unit}} · 可编辑</view>
          <view wx:if="{{item.targetText}}" class="target">{{item.targetText}}</view>
        </view>

      </view>

      <view wx:if="{{item.expanded}}" class="entries">
        <view class="entry-list">
          <view
            wx:for="{{item.entries}}"
            wx:for-item="entry"
            wx:for-index="entryIndex"
            wx:key="id"
            class="entry"
          >
            <view class="entry-main">
              <text class="entry-amount">{{entry.amountText}} {{item.unit}}</text>
              <text class="entry-time">{{entry.timeText}}</text>
              <text wx:if="{{entry.changeText}}" class="entry-change">{{entry.changeText}}</text>
            </view>
            <view
              class="btn btn-ghost btn-sm"
              data-entry-id="{{entry.id}}"
              data-amount="{{entry.amount}}"
              data-time="{{entry.timeText}}"
              data-unit="{{item.unit}}"
              catchtap="onUndoEntry"
            >撤销</view>
          </view>
        </view>
        <view class="entries-note">撤销后，当日总数将恢复这笔补录的变化。</view>
      </view>
    </view>
  </view>
  </block>
  </block>
</view>

<view wx:if="{{canEntry}}" class="page day-entry"><button class="btn btn-plain" bindtap="openEntry">按增减数量补录</button></view>
<entry-sheet id="entry-sheet" visible="{{entryVisible}}" date="{{date}}" bind:close="closeEntry" bind:saved="onEntrySaved" />
