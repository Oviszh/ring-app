/* P9 当日详情 —— 基于 app.wxss 设计系统 v2 */

.day-head {
  padding: 4rpx 4rpx 20rpx;
}

.day-head-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-ink);
}

.day-head-sub {
  margin-top: 4rpx;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

/* —— 功课列表 —— */

.list-card { padding-top: 4rpx; padding-bottom: 4rpx; }
.day-group-title { margin-top: 28rpx; margin-bottom: 16rpx; }

.item { border-bottom: 2rpx solid var(--c-border); }
.item:last-child { border-bottom: none; }
.item.on {
  margin: 0 -20rpx;
  padding: 0 20rpx;
  background: var(--c-primary-weak);
  border-radius: var(--radius-sm);
}

.item .row {
  border-bottom: none;
  align-items: flex-start;
  padding-top: 26rpx;
  padding-bottom: 24rpx;
}

.item .row-arrow { margin-top: 10rpx; }

.row-title {
  display: flex;
  align-items: center;
  min-width: 0;
}

.name {
  display: inline-block;
  max-width: 360rpx;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  vertical-align: bottom;
}

.tag {
  display: inline-block;
  flex-shrink: 0;
  margin-left: 14rpx;
  padding: 0 14rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 999rpx;
  background: var(--c-track);
  color: var(--c-ink-2);
  font-size: 20rpx;
  vertical-align: middle;
}

/* 状态圆点：● 绿 达标 / ◐ 橙 部分 / ○ 灰 未完成 / · 无目标 */
.st {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.st-met { background: var(--c-success); }
.st-partial { background: var(--c-warn); }
.st-missed {
  background: transparent;
  border: 3rpx solid var(--c-ink-3);
}
.st-none { background: var(--c-track); }

.nums {
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 2rpx;
  text-align: right;
}

.amount {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.check {
  margin-right: 12rpx;
  color: var(--c-success);
}

.target {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

/* —— 手动填报展开 —— */

.entry-toggle {
  margin-top: 10rpx;
  font-size: var(--fs-small);
  color: var(--c-primary);
}

.toggle-arrow {
  margin-left: 12rpx;
  font-size: var(--fs-mini);
  color: var(--c-primary);
}

.entries {
  margin: 0 0 24rpx;
  padding: 8rpx 24rpx 16rpx;
  background: var(--c-bg);
  border-radius: var(--radius-sm);
}

.entry {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 2rpx solid var(--c-border);
}
.entry:last-child { border-bottom: none; }

.entry-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.entry-amount {
  font-size: var(--fs-small);
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.entry-time {
  margin-left: 16rpx;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

.btn-sm {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin-left: 20rpx;
  font-size: var(--fs-mini);
  font-weight: 500;
  border-radius: 12rpx;
}

.entries-note {
  padding-top: 12rpx;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
  line-height: 1.6;
}

.day-entry { padding-top: 0; }.day-entry .btn { width: 100%; }.row-title .name { white-space: normal; overflow-wrap: break-word; }
.total-input { width: 200rpx; min-height: 84rpx; height: 84rpx; border: 1rpx solid var(--c-border); border-radius: 12rpx; background: var(--c-bg); padding: 0 16rpx; font-size: 36rpx; color: var(--c-primary); text-align: right; font-weight: 600; }
.edit-caption { font-size: 22rpx; color: var(--c-ink-2); padding-top: 6rpx; }
.entry-main { flex-wrap: wrap; gap: 4rpx 0; }
.entry-change { width: 100%; font-size: 24rpx; color: var(--c-ink-2); }
.row-main { min-width: 0; }.name { max-width: 100%; }
