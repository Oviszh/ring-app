<view class="page">
  <view class="page-heading"><view class="eyebrow">日积月累</view><view class="page-title">我的修行</view><view class="page-description">记录仅保存在这台手机上</view></view>
  <view class="card overview"><view class="overview-item"><view class="overview-number">{{recordDays}}<text>天</text></view><view class="overview-label">有记录的日子</view></view><view class="overview-divider"></view><view class="overview-item"><view class="overview-number">{{practiceCount}}<text>项</text></view><view class="overview-label">正在修习的功课</view></view></view>
  <view class="section-title">修行记录</view>
  <view class="card menu-card">
    <view class="row" bindtap="goSummary"><view class="menu-icon icon-summary"><view></view><view></view><view></view></view><view class="row-main"><view class="row-title">累计记录</view><view class="row-sub">各项功课的累计数量与时长</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="goVows"><view class="menu-icon icon-vow"><view></view></view><view class="row-main"><view class="row-title">长期大愿</view><view class="row-sub">查看长期目标与进度</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="goPractices"><view class="menu-icon icon-practices"><view></view><view></view><view></view></view><view class="row-main"><view class="row-title">功课管理</view><view class="row-sub">调整分组、顺序与删除功课</view></view><text class="row-arrow">›</text></view>
  </view>
  <view class="section-title">设备与数据</view>
  <view class="card menu-card">
    <view class="row" bindtap="goDevices"><view class="row-main"><view class="row-title">我的设备</view><view class="row-sub">{{deviceCount ? '已绑定 ' + deviceCount + ' 台设备' : '未绑定设备'}}</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="goBackup"><view class="row-main"><view class="row-title">备份与恢复</view><view class="row-sub">将修行记录另存一份</view></view><text class="row-arrow">›</text></view>
    <view class="row" bindtap="goSettings"><view class="row-main"><view class="row-title">设置</view><view class="row-sub">计数偏好与隐私说明</view></view><text class="row-arrow">›</text></view>
  </view>
  <view class="local-note"><view class="local-note-title">记录保存在这台手机上</view><view>换手机或清理微信数据前，请先导出备份。</view><view class="backup-link" bindtap="goBackup">备份记录 ›</view></view>
  <view class="foot">永久免费 · 无广告</view>
</view>
