<!-- 我的 Tab（P1''-A 游客模式） -->
<view class="page">

  <!-- 游客卡片 -->
  <view class="card guest">
    <view class="guest-head">
      <view class="guest-mark">念</view>
      <view class="guest-body">
        <view class="guest-title">游客模式 · 数据仅存本机</view>
        <view class="guest-desc">记录只保存在这台手机上。清理微信数据或删除小程序可能丢失，建议定期备份。</view>
      </view>
    </view>
    <button class="btn btn-ghost guest-btn" bindtap="onLogin">登录 / 注册</button>
  </view>

  <!-- 修行入口 -->
  <view class="section-title">修行</view>
  <view class="card">
    <view class="row" bindtap="goVows">
      <view class="row-main">
        <view class="row-title">长期大愿</view>
        <view class="row-sub">愿心有归处，修行有方向</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goSummary">
      <view class="row-main">
        <view class="row-title">计数汇总</view>
        <view class="row-sub">累计用功，来源清晰</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goPractices">
      <view class="row-main">
        <view class="row-title">功课管理</view>
        <view class="row-sub">调整顺序，控制首页显示</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 设备与数据 -->
  <view class="section-title">设备与数据</view>
  <view class="card">
    <view class="row" bindtap="onDevices">
      <view class="row-main">
        <view class="row-title">我的设备（{{deviceCount}} 枚）</view>
        <view class="row-sub">{{deviceCount ? '查看已绑定戒指与同步状态' : '还没有绑定戒指'}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goBackup">
      <view class="row-main">
        <view class="row-title">备份与恢复</view>
        <view class="row-sub">导出到文件传输助手留存</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goSettings">
      <view class="row-main">
        <view class="row-title">设置</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <view class="foot">永久免费 · 清净无广告</view>
</view>
