<!-- P1'' 我的：P1''-A 游客模式（本阶段无登录，设备列表为空） -->
<view class="page">
  <!-- 游客卡片 -->
  <view class="card">
    <view class="card-title">游客模式 · 数据仅存本机</view>
    <view class="card-desc">注册登录后开启云同步，换机/重装也能找回历史</view>
    <button class="card-btn" bindtap="onLogin">登录 / 注册</button>
  </view>

  <!-- 入口列表 -->
  <view class="list">
    <view class="row" bindtap="onDevices">
      <text class="row-label">我的设备（{{deviceCount}} 枚）</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goVows">
      <text class="row-label">长期大愿</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goSummary">
      <text class="row-label">计数汇总</text>
      <text class="row-arrow">›</text>
    </view>
    <view class="row" bindtap="goSettings">
      <text class="row-label">设置</text>
      <text class="row-arrow">›</text>
    </view>
  </view>
</view>
