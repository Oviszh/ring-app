/* 我的 Tab —— 基于 app.wxss 设计系统 */

/* —— 游客卡片 P1''-A —— */
.guest-head {
  display: flex;
  align-items: flex-start;
}

.guest-mark {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guest-body { flex: 1; min-width: 0; }

.guest-title {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.4;
}

.guest-desc {
  margin-top: 8rpx;
  font-size: var(--fs-small);
  line-height: 1.7;
  color: var(--c-ink-2);
}

.guest-btn {
  margin-top: 28rpx;
  width: 100%;
  padding: 0;
}

/* —— 页脚 —— */
.foot {
  text-align: center;
  font-size: var(--fs-small);
  color: var(--c-ink-3);
  padding: 24rpx 0 8rpx;
}
