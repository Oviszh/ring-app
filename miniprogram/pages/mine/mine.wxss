.overview { display: flex; align-items: center; padding: 36rpx 20rpx; }
.overview-item { flex: 1; text-align: center; }
.overview-number { font-size: 60rpx; line-height: 1.3; font-weight: 400; font-variant-numeric: tabular-nums; }
.overview-number text { font-size: 26rpx; color: var(--c-ink-2); margin-left: 10rpx; }
.overview-label { font-size: 26rpx; color: var(--c-ink-2); margin-top: 12rpx; }
.overview-divider { height: 64rpx; width: 1rpx; background: var(--c-border); }
.menu-card { padding-top: 4rpx; padding-bottom: 4rpx; }
.menu-icon { width: 44rpx; height: 44rpx; margin-right: 24rpx; color: var(--c-primary); flex-shrink: 0; }
.icon-summary { display: flex; align-items: flex-end; gap: 7rpx; padding: 5rpx; }
.icon-summary view { width: 6rpx; height: 20rpx; background: var(--c-primary); border-radius: 2rpx; }
.icon-summary view:nth-child(2) { height: 34rpx; }.icon-summary view:nth-child(3) { height: 26rpx; }
.icon-vow { display: flex; align-items: center; justify-content: center; }.icon-vow view { width: 31rpx; height: 31rpx; border: 2rpx solid var(--c-primary); border-radius: 50%; position: relative; }.icon-vow view::after { content: ''; position: absolute; width: 9rpx; height: 9rpx; background: var(--c-primary); border-radius: 50%; left: 9rpx; top: 9rpx; }
.icon-practices { padding-top: 7rpx; }.icon-practices view { height: 2rpx; width: 30rpx; margin: 0 0 10rpx 6rpx; background: var(--c-primary); }
.local-note { padding: 12rpx 8rpx; color: var(--c-ink-2); font-size: 26rpx; line-height: 1.8; }
.local-note-title { color: var(--c-ink); margin-bottom: 6rpx; font-size: 28rpx; }
.backup-link { color: var(--c-primary); padding: 12rpx 0; }
.foot { text-align: center; color: var(--c-ink-2); font-size: 24rpx; padding: 32rpx 0 8rpx; }
