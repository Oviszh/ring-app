/* P10 修正记录 —— 基于 app.wxss 设计系统 v2 */

.head { padding: 4rpx 4rpx 20rpx; }

.head-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-ink);
}

.head-sub {
  margin-top: 4rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

/* —— 当前值 —— */

.cur-card { text-align: center; }

.cur-cap {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.cur-num {
  margin: 12rpx 0 8rpx;
  font-size: var(--fs-big);
  font-weight: 600;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
}

.split {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--c-border);
}

.split-item {
  flex: 1;
  text-align: center;
}

.split-label {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

.split-value {
  margin-top: 2rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

/* —— 来源选择 —— */

.hint {
  margin: 14rpx 4rpx 0;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
  line-height: 1.6;
}

/* —— 修改为 —— */

.input-card {
  margin-top: var(--space);
  text-align: center;
}

.input-cap {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.input-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 8rpx 0 4rpx;
}

.big-input {
  flex: none;
  width: 320rpx;
  height: 120rpx;
  border: none;
  background: transparent;
  text-align: center;
  font-size: var(--fs-big);
  font-weight: 600;
  color: var(--c-led);
  font-variant-numeric: tabular-nums;
}

.big-ph {
  color: var(--c-ink-3);
  font-weight: 300;
}

.input-unit {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

.from-line {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

.delta {
  margin-top: 20rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-primary);
}

.error {
  margin-top: 20rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-danger);
}

/* —— 规则 —— */

.rules {
  margin: 8rpx 8rpx 32rpx;
  font-size: var(--fs-mini);
  line-height: 1.7;
  color: var(--c-ink-2);
}

/* —— 确认按钮 —— */

.btn-primary { width: 100%; }

.btn.off {
  background: var(--c-track);
  color: var(--c-ink-3);
}

/* —— 已有修正 —— */

.adj-title { margin-top: 44rpx; }

.adj-card { padding-top: 4rpx; padding-bottom: 4rpx; }

.adj-row { padding: 20rpx 4rpx; }

.adj-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-small);
  color: var(--c-ink);
}

.btn-sm {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin-left: 20rpx;
  font-size: var(--fs-mini);
  font-weight: 500;
  border-radius: 12rpx;
}
