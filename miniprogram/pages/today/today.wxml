<!-- P1 今日：纸卡计数区 + 设备/手机页签 -->
<view class="page">

  <!-- 空状态 -->
  <block wx:if="{{empty}}">
    <view wx:if="{{!emptyHidden}}" class="empty">
      <view class="empty-mark">念</view>
      <view class="empty-title">还没有功课</view>
      <view class="empty-sub">添加一个常修的功课，开始今天的修行吧</view>
      <button class="btn btn-primary" style="width: 70%;" bindtap="goPracticeAdd">＋ 添加功课</button>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">首页还没有要显示的功课</view>
      <view class="empty-sub">到「配置功课」里打开功课的首页显示，或添加新功课</view>
      <button class="btn btn-ghost" style="width: 70%;" bindtap="onConfig">配置功课</button>
      <button class="btn btn-primary" style="width: 70%; margin-top: 24rpx;" bindtap="goPracticeAdd">＋ 添加功课</button>
    </view>
  </block>

  <block wx:else>

    <!-- 纯填报模式 -->
    <block wx:if="{{fillOnly}}">
      <view class="card fill-hero">
        <view class="fill-title">当前以手动填报记录修行</view>
        <button class="btn btn-primary" bindtap="openEntry">✎ 填报今日数据</button>
      </view>
    </block>

    <block wx:else>
      <!-- 计数纸卡（回纹角 + 莲花饰 + 墨字大数字） -->
      <view class="count-card">
        <view class="corner tl"></view>
        <view class="corner tr"></view>
        <view class="corner bl"></view>
        <view class="corner br"></view>

        <view class="count-head">
          <view class="count-arrow {{canSwitch ? '' : 'off'}}" bindtap="onPrevPractice">‹</view>
          <view class="count-name">
            <text class="orn">❀</text>
            <text class="name-text">{{currentName}}</text>
            <text class="orn">❀</text>
          </view>
          <view class="count-arrow {{canSwitch ? '' : 'off'}}" bindtap="onNextPractice">›</view>
        </view>

        <!-- 戒指未绑定：页签可见但计数区显示引导 -->
        <block wx:if="{{ringEmpty}}">
          <view class="count-empty">暂无绑定戒指</view>
          <view class="count-empty-sub">绑定念佛戒指后，这里显示戒指上的实时计数</view>
          <button class="btn btn-ghost bind-btn" bindtap="goBind">去绑定戒指</button>
        </block>

        <block wx:else>
          <view class="count-num {{ringLocked && side === 'ring' ? 'dim' : ''}}">{{ledText}}</view>
          <view class="count-caption">{{ledCaption}}{{ringLocked && side === 'ring' ? ' · 已锁定' : ''}}</view>
          <view class="count-divider"></view>
          <view class="count-today">{{todayText}}</view>

          <view wx:if="{{side === 'phone'}}" class="count-actions">
            <button class="btn btn-primary" bindtap="goWoodfish">{{isTime ? '进入静坐计时' : '进入手机计数'}}</button>
          </view>
          <view wx:elif="{{side === 'ring'}}" class="count-ringbar">
            <view class="count-ring-item" bindtap="onRingLock">{{ringLocked ? '🔒 已锁定 · 点按解锁' : '🔓 锁定戒指'}}</view>
            <view class="count-ring-item" bindtap="onRingSync">⟳ {{syncText}}</view>
          </view>
        </block>
      </view>

      <!-- 设备/手机页签（位于卡片下方，如宣纸托底） -->
      <view wx:if="{{tabsVisible}}" class="side-tabs">
        <view class="side-tab {{side === 'ring' ? 'on' : ''}}" data-side="ring" bindtap="onSideTab">设备计数</view>
        <view class="side-tab {{side === 'phone' ? 'on' : ''}}" data-side="phone" bindtap="onSideTab">手机计数</view>
      </view>

      <view class="entry-link" bindtap="openEntry">✎ 填报今日数据</view>
    </block>

    <!-- 功课列表 -->
    <view class="list-head">
      <view class="list-head-main">
        <view class="list-title">功课</view>
        <view class="list-bar"></view>
      </view>
      <view class="list-config" bindtap="onConfig">配置功课</view>
    </view>

    <view
      wx:for="{{practices}}"
      wx:key="id"
      class="p-card"
      data-id="{{item.id}}"
      bindtap="onPracticeTap"
    >
      <image class="p-icon" src="/assets/icons/lotus-gold.png" mode="aspectFit" />
      <view class="p-main">
        <view class="p-name">{{item.name}}</view>
        <view class="p-sub">{{item.progressText}}</view>
      </view>
      <view class="p-num">{{item.totalText}}</view>
      <text class="p-arrow">›</text>
    </view>

    <view class="p-card p-add" bindtap="goPracticeAdd">
      <view class="p-add-text">＋ 添加功课</view>
    </view>

    <view wx:if="{{fillOnly}}" class="foot-link" bindtap="goSettings">计数入口已关闭 · 去设置开启 ›</view>
  </block>

  <!-- E3 填报弹层 -->
  <block wx:if="{{entryVisible}}">
    <view class="sheet-mask" catchtouchmove="noop" bindtap="closeEntry"></view>
    <view class="sheet">
      <view class="sheet-close" bindtap="closeEntry">✕</view>
      <view class="sheet-title">填报</view>
      <view class="sheet-sub">记的是「本次新增数量」，不是当天总数</view>

      <picker mode="date" value="{{entryDate}}" end="{{todayKey}}" bindchange="onEntryDateChange">
        <view class="field">
          <text class="field-label">日期</text>
          <text class="field-value">{{entryDateLabel}}</text>
          <text class="field-arrow">▾</text>
        </view>
      </picker>

      <picker mode="selector" range="{{entryPractices}}" range-key="name" value="{{entryPracticeIndex}}" bindchange="onEntryPracticeChange">
        <view class="field">
          <text class="field-label">功课</text>
          <text class="field-value">{{entryPracticeName}}</text>
          <text class="field-arrow">▾</text>
        </view>
      </picker>

      <view class="field">
        <text class="field-label">本次新增</text>
        <input class="field-input" type="number" value="{{entryAmount}}" placeholder="如 500" placeholder-class="field-ph" bindinput="onEntryAmountInput" />
        <text class="field-unit">{{entryUnit}}</text>
      </view>

      <view class="btn-row" style="margin-top: 32rpx;">
        <button class="btn btn-plain" bindtap="saveEntryAndContinue">保存并继续填报</button>
        <button class="btn btn-primary" bindtap="saveEntry">保存</button>
      </view>

      <view class="sheet-note">填报记为「手动」来源，计入今日累积与个人大愿；填错了可在 日历 → 当日详情 中撤销；纠正误触请用「修正」。</view>
    </view>
  </block>
</view>
