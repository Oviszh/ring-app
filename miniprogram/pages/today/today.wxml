<view class="page today-page">
  <view class="today-heading"><view><view class="eyebrow">{{dateLabel}}</view><view class="page-title">当前计数</view></view><view class="saved-mark"><view class="saved-dot"></view>本机记录</view></view>
  <view wx:if="{{!fillOnly}}" class="counter-shell {{tabsVisible ? 'has-tabs' : ''}}">
    <view class="counter-card">
      <view class="counter-top"><text class="counter-label">{{counterLabel}}</text><view class="switch-controls"><button class="switch-arrow" disabled="{{!canSwitch}}" bindtap="onPrevPractice" aria-label="上一项功课">‹</button><button class="switch-arrow" disabled="{{!canSwitch}}" bindtap="onNextPractice" aria-label="下一项功课">›</button></view></view>
      <view class="counter-name">{{currentName}}</view>
      <view class="counter-screen {{ringEmpty ? 'screen-unbound' : ''}}">
        <view class="screen-caption"><text>{{isTime ? '本座时长' : '本轮计数'}}</text><text>{{ringEmpty ? '未绑定' : (side === 'ring' && ringLocked ? '已锁定' : unit)}}</text></view>
        <led-number id="today-led" value="{{roundText}}" dimmed="{{ringEmpty}}" />
      </view>
      <view wx:if="{{ringEmpty}}" class="unbound-status"><view class="unbound-title">未绑定设备</view><view class="unbound-description">绑定后，可在这里查看设备计数。</view></view>
      <view wx:else class="counter-meta"><text>今日 {{todayText}} {{unit}}</text></view>
      <view wx:if="{{side === 'ring' && ringBound}}" class="device-status">{{deviceStatus}}{{!deviceConnected ? ' · 显示上次同步记录' : ''}}</view>
      <view wx:if="{{reminderText}}" class="counter-reminder">{{reminderText}}</view>
      <view wx:if="{{side === 'phone'}}" class="btn-row counter-actions"><button class="btn btn-primary" bindtap="goWoodfish">{{empty ? '添加功课' : (isTime ? (hasContext ? '继续静坐' : '开始静坐') : (hasContext ? '继续计数' : '开始计数'))}}</button></view>
      <view wx:else class="btn-row counter-actions"><button class="btn btn-primary" disabled="{{busy}}" bindtap="onDevicePrimary">{{!ringBound ? '绑定设备' : (hasContext ? '设备管理' : '开始设备计数')}}</button></view>
      <view wx:if="{{side === 'ring' && ringBound}}" class="device-tools"><view bindtap="onRingLock">{{ringLocked ? '解锁计数' : '锁定计数'}}</view><view bindtap="onRingSync">{{busy ? '处理中…' : '同步设备'}}</view></view>
    </view>
    <view wx:if="{{tabsVisible}}" class="count-tabs" role="tablist">
      <view wx:if="{{ringEnabled}}" class="count-tab {{side === 'ring' ? 'on' : ''}}" role="tab" aria-selected="{{side === 'ring'}}" data-side="ring" bindtap="onSideTab">设备计数</view>
      <view wx:if="{{phoneEnabled}}" class="count-tab {{side === 'phone' ? 'on' : ''}}" role="tab" aria-selected="{{side === 'phone'}}" data-side="phone" bindtap="onSideTab">触屏计数</view>
    </view>
  </view>
  <view wx:else class="card manual-card"><view class="manual-title">记下今日的用功</view><view class="row-sub">只用填报，也能完整记录日常功课。</view><button class="btn btn-primary" bindtap="openEntry">{{empty ? '添加功课' : '补录功课'}}</button><view class="manual-settings" bindtap="goSettings">计数入口已关闭 · 去设置开启 ›</view></view>
  <view class="list-heading"><view class="list-heading-title">我的功课</view><button class="text-button" bindtap="onConfig">管理</button></view>
  <view wx:if="{{practices.length}}" class="practice-groups">
    <block wx:for="{{practiceGroups}}" wx:for-item="group" wx:key="key"><view wx:if="{{group.rows.length}}" class="practice-group group-{{group.key}}"><view class="group-heading"><text>{{group.name}}</text><text class="group-note">{{group.note}}</text></view><view class="practice-list">
    <view class="practice-row" wx:for="{{group.rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onPracticeTap" hover-class="practice-hover">
      <view class="practice-info"><view class="practice-name">{{item.name}}</view><view wx:if="{{item.detail}}" class="row-sub">{{item.detail}}</view><view class="practice-target">{{item.targetText}}<text wx:if="{{item.done}}" class="done-label"> · 已达标</text></view><view wx:if="{{item.hasTarget}}" class="progress practice-progress"><view class="progress-fill" style="{{item.barStyle}}"></view></view></view>
      <view class="practice-total"><view class="practice-number">{{item.totalText}}</view><view class="practice-unit">{{item.unit}}</view></view><text class="practice-chevron">›</text>
    </view>
    </view></view></block>
  </view>
  <view wx:else class="list-empty"><text>{{emptyHidden ? '功课已收起，可在管理中重新显示。' : '添加常修的功课，记录每天的用功。'}}</text></view>
  <button class="add-practice" bindtap="openEntry">补录</button>
</view>
<entry-sheet id="entry-sheet" visible="{{entryVisible}}" practice-id="{{currentPracticeId}}" bind:close="closeEntry" bind:saved="onEntrySaved" />
