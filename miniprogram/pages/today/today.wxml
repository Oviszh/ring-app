<!-- P1 今日：空状态 P1-F / 仅手机计数 P1-E / 填报弹层 E3 -->
<view class="page">
  <view class="home-heading"><view><view class="eyebrow">{{dateLabel}} · 日常修持</view><view class="page-heading">今日修行</view></view><view class="seal">念</view></view>
  <!-- 空状态 P1-F：首次打开 / 功课都关闭了首页显示 -->
  <view wx:if="{{empty && !emptyHidden}}" class="empty-wrap">
    <view class="enso"><view class="enso-core"></view></view><view class="empty-title">一念一行，日积月累</view>
    <view class="empty-sub">从一项常修功课开始。
手机计数，或随时填报，
每一份用功都安稳留存。</view>
    <button class="btn-primary empty-btn" bindtap="goPracticeAdd">添加第一项功课</button>
  </view>
  <view wx:elif="{{empty}}" class="empty-wrap">
    <view class="empty-title">首页还没有要显示的功课</view>
    <view class="empty-sub">到「配置」里打开功课的首页显示，或添加新功课</view>
    <button class="btn-secondary empty-btn" bindtap="onConfig">管理功课</button><button class="btn-secondary empty-btn" bindtap="openEntry">填报修行</button>
    <button class="btn-primary empty-btn empty-btn-second" bindtap="goPracticeAdd">＋ 添加功课</button>
  </view>

  <block wx:else>
    <!-- P1-G 纯填报模式；否则为 P1-E 计数卡片 -->
    <view wx:if="{{fillOnly}}" class="fill-card">
      <view class="fill-title">当前以手动填报记录修行</view>
      <button class="btn-primary fill-btn" bindtap="openEntry">填报修行记录</button>
    </view>
    <view wx:else class="led-card">
      <view class="switch-row">
        <view class="switch-btn {{canSwitch ? '' : 'switch-btn--disabled'}}" bindtap="onPrevPractice">‹</view>
        <view class="practice-name">{{currentName}}</view>
        <view class="switch-btn {{canSwitch ? '' : 'switch-btn--disabled'}}" bindtap="onNextPractice">›</view>
      </view>

      <view class="led-num">{{ledText}}</view>
      <view class="led-caption">{{isTime ? '本座分钟 · 手机' : '本轮计数 · 手机'}}</view>
      <view class="today-line">{{todayText}}</view>

      <button wx:if="{{phoneEnabled}}" class="btn-primary led-enter" bindtap="goWoodfish">{{isTime ? '进入静坐计时' : '开始念佛计数'}}</button>

      <view class="entry-link" bindtap="openEntry">填报修行记录　＋</view>
    </view>

    <!-- 我的功课 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">我的功课</text>
        <view class="section-action" bindtap="onConfig">管理 ›</view>
      </view>

      <view
        wx:for="{{practices}}"
        wx:key="id"
        class="practice-row"
        data-id="{{item.id}}"
        bindtap="onPracticeTap"
      >
        <view wx:if="{{!fillOnly}}" class="dot {{item.current ? 'dot--on' : ''}}"></view>
        <view class="practice-main"><view class="row-name">{{item.name}}</view><view class="row-progress">{{item.progressText}}</view><view class="mini-track"><view class="mini-fill" style="width:{{item.percent}}%"></view></view></view>
        <text class="row-arrow">›</text>
      </view>

      <view class="add-row" bindtap="goPracticeAdd">＋ 添加功课</view>
    </view>

    <!-- P1-G 底部提示 -->
    <view wx:if="{{fillOnly}}" class="foot-link" bindtap="goSettings">计数入口已关闭 · 去设置开启 ›</view>
  </block>
  <view class="quiet-footer">一心专念 · 日日相续</view>

  <!-- E3 填报弹层 -->
  <view
    wx:if="{{entryVisible}}"
    class="mask"
    catchtouchmove="noop"
    bindtap="closeEntry"
  >
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">填报</text>
        <view class="sheet-close" bindtap="closeEntry">✕</view>
      </view>

      <picker mode="date" value="{{entryDate}}" end="{{todayKey}}" bindchange="onEntryDateChange">
        <view class="field">
          <text class="field-label">日期</text>
          <text class="field-value">{{entryDateLabel}}</text>
          <text class="field-arrow">▾</text>
        </view>
      </picker>

      <picker
        mode="selector"
        range="{{entryPractices}}"
        range-key="name"
        value="{{entryPracticeIndex}}"
        bindchange="onEntryPracticeChange"
      >
        <view class="field">
          <text class="field-label">功课</text>
          <text class="field-value">{{entryPracticeName}}</text>
          <text class="field-arrow">▾</text>
        </view>
      </picker>

      <view class="field">
        <text class="field-label">本次新增</text>
        <input
          class="amount-input"
          type="number"
          value="{{entryAmount}}"
          placeholder="本次新增数量"
          placeholder-class="amount-ph"
          bindinput="onEntryAmountInput"
        />
        <text class="field-unit">{{entryUnit}}</text>
      </view>

      <view class="sheet-btns">
        <button class="btn-primary btn-save" bindtap="saveEntry">保存</button>
        <button class="btn-secondary btn-continue" bindtap="saveEntryAndContinue">保存并继续填报</button>
      </view>

      <view class="sheet-note">填报记为手动来源。计数填写本次新增数量；禅坐填写分钟数，每笔计一座。填错可在当日详情撤销。</view>
    </view>
  </view>
</view>
