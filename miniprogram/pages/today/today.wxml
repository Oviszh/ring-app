<!-- P1 今日 -->
<view class="page">

  <!-- 空状态 -->
  <block wx:if="{{empty}}">
    <view wx:if="{{!emptyHidden}}" class="empty">
      <view class="empty-mark">念</view>
      <view class="empty-title">还没有功课</view>
      <view class="empty-sub">添加一个常修的功课，开始今天的修行吧</view>
      <button class="btn btn-primary" style="width: 70%;" bindtap="goPracticeAdd">＋ 添加功课</button>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">首页还没有要显示的功课</view>
      <view class="empty-sub">到「配置」里打开功课的首页显示，或添加新功课</view>
      <button class="btn btn-ghost" style="width: 70%;" bindtap="onConfig">管理功课</button>
      <button class="btn btn-primary" style="width: 70%; margin-top: 24rpx;" bindtap="goPracticeAdd">＋ 添加功课</button>
    </view>
  </block>

  <block wx:else>

    <!-- P1-G 纯填报模式 -->
    <block wx:if="{{fillOnly}}">
      <view class="card fill-hero">
        <view class="fill-title">当前以手动填报记录修行</view>
        <button class="btn btn-primary" bindtap="openEntry">✎ 填报今日数据</button>
      </view>
    </block>

    <!-- 计数主视觉 -->
    <block wx:else>
      <view wx:if="{{hasRing}}" class="seg" style="margin-bottom: 24rpx;">
        <view class="seg-item {{side === 'ring' ? 'on' : ''}}" data-side="ring" bindtap="onSideTab">戒指计数</view>
        <view class="seg-item {{side === 'phone' ? 'on' : ''}}" data-side="phone" bindtap="onSideTab">手机计数</view>
      </view>

      <view class="card-hero">
        <view class="hero-head">
          <view class="hero-arrow {{canSwitch ? '' : 'off'}}" bindtap="onPrevPractice">‹</view>
          <view class="hero-name">{{currentName}}</view>
          <view class="hero-arrow {{canSwitch ? '' : 'off'}}" bindtap="onNextPractice">›</view>
        </view>

        <view class="hero-num {{ringLocked && side === 'ring' ? 'dim' : ''}}">{{ledText}}</view>
        <view class="hero-caption">{{ledCaption}}{{ringLocked && side === 'ring' ? ' · 已锁定' : ''}}</view>

        <view class="hero-divider"></view>
        <view class="hero-today">{{todayText}}</view>

        <view wx:if="{{side === 'phone' && phoneEnabled}}" class="hero-actions">
          <button class="btn btn-hero" bindtap="goWoodfish">{{isTime ? '进入静坐计时' : '进入手机计数'}}</button>
        </view>
        <view wx:if="{{side === 'ring'}}" class="hero-ring-bar">
          <view class="hero-ring-item" bindtap="onRingLock">{{ringLocked ? '🔒 已锁定 · 点按解锁' : '🔓 锁定戒指'}}</view>
          <view class="hero-ring-item" bindtap="onRingSync">⟳ {{syncText}}</view>
        </view>
      </view>

      <view class="entry-link" bindtap="openEntry">✎ 填报今日数据</view>
    </block>

    <!-- 我的功课 -->
    <view class="section-title">我的功课</view>
    <view class="card" style="padding-top: 10rpx; padding-bottom: 10rpx;">
      <view
        wx:for="{{practices}}"
        wx:key="id"
        class="row"
        data-id="{{item.id}}"
        bindtap="onPracticeTap"
      >
        <view wx:if="{{!fillOnly}}" class="dot {{item.current ? 'dot-on' : ''}}"></view>
        <view class="row-main">
          <view class="row-title">{{item.name}}</view>
          <view class="row-sub">{{item.progressText}}</view>
          <view class="mini-track"><view class="mini-fill" style="{{item.barStyle}}"></view></view>
        </view>
        <text class="row-arrow">›</text>
      </view>
      <view class="row add-row" bindtap="goPracticeAdd">
        <view class="row-main add-text">＋ 添加功课</view>
      </view>
    </view>

    <view wx:if="{{fillOnly}}" class="foot-link" bindtap="goSettings">计数入口已关闭 · 去设置开启 ›</view>
  </block>

  <!-- E3 填报弹层 -->
  <block wx:if="{{entryVisible}}">
    <view class="sheet-mask" catchtouchmove="noop" bindtap="closeEntry"></view>
    <view class="sheet">
      <view class="sheet-close" bindtap="closeEntry">✕</view>
      <view class="sheet-title">填报</view>
      <view class="sheet-sub">记的是「本次新增数量」，不是当天总数</view>

      <picker mode="date" value="{{entryDate}}" end="{{todayKey}}" bindchange="onEntryDateChange">
        <view class="field">
          <text class="field-label">日期</text>
          <text class="field-value">{{entryDateLabel}}</text>
          <text class="field-arrow">▾</text>
        </view>
      </picker>

      <picker mode="selector" range="{{entryPractices}}" range-key="name" value="{{entryPracticeIndex}}" bindchange="onEntryPracticeChange">
        <view class="field">
          <text class="field-label">功课</text>
          <text class="field-value">{{entryPracticeName}}</text>
          <text class="field-arrow">▾</text>
        </view>
      </picker>

      <view class="field">
        <text class="field-label">本次新增</text>
        <input class="field-input" type="number" value="{{entryAmount}}" placeholder="如 500" placeholder-class="field-ph" bindinput="onEntryAmountInput" />
        <text class="field-unit">{{entryUnit}}</text>
      </view>

      <view class="btn-row" style="margin-top: 32rpx;">
        <button class="btn btn-plain" bindtap="saveEntryAndContinue">保存并继续填报</button>
        <button class="btn btn-primary" bindtap="saveEntry">保存</button>
      </view>

      <view class="sheet-note">填报记为「手动」来源，计入今日累积与个人大愿；填错了可在 日历 → 当日详情 中撤销；纠正误触请用「修正」。</view>
    </view>
  </block>
</view>
