/* 今日页（样板页）——基于 app.wxss 设计系统 */

/* —— 空状态 —— */
.empty-mark {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

/* —— 计数卡片 —— */
.counter-card {
  padding-top: 36rpx;
  text-align: center;
}

.counter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.counter-arrow {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 56rpx;
  color: var(--c-primary);
  border-radius: 50%;
}
.counter-arrow:active { background: var(--c-primary-weak); }
.counter-arrow.off { color: var(--c-ink-3); }

.counter-name {
  font-size: var(--fs-title);
  font-weight: 600;
  flex: 1;
}

.counter-num {
  font-size: var(--fs-hero);
  font-weight: 200;
  letter-spacing: 2rpx;
  color: var(--c-led);
  margin: 32rpx 0 4rpx;
  font-variant-numeric: tabular-nums;
}
.counter-num.dim { color: var(--c-ink-3); }

.counter-caption {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
  margin-bottom: 20rpx;
}

.counter-today {
  font-size: var(--fs-small);
  color: var(--c-ink-2);
  padding: 16rpx 0 8rpx;
  border-top: 2rpx solid var(--c-border);
}

.counter-actions { margin-top: 24rpx; }

.ring-bar {
  display: flex;
  border-top: 2rpx solid var(--c-border);
  margin-top: 4rpx;
}
.ring-bar-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 4rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}
.ring-bar-item:first-child { border-right: 2rpx solid var(--c-border); }

/* —— 填报入口 —— */
.entry-link {
  text-align: center;
  color: var(--c-primary);
  font-size: var(--fs-body);
  padding: 28rpx 0 8rpx;
  font-weight: 500;
}

/* —— 功课列表 —— */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--c-track);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.dot-on { background: var(--c-primary); }

.mini-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--c-track);
  margin-top: 10rpx;
  overflow: hidden;
}
.mini-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--c-primary);
}

.add-row { justify-content: center; }
.add-text {
  text-align: center;
  color: var(--c-primary);
  font-size: var(--fs-body);
  font-weight: 500;
}

/* —— 纯填报模式 —— */
.fill-hero { text-align: center; padding: 56rpx 32rpx; }
.fill-title { font-size: var(--fs-body); color: var(--c-ink-2); margin-bottom: 36rpx; }
.foot-link {
  text-align: center;
  color: var(--c-ink-2);
  font-size: var(--fs-small);
  padding: 24rpx 0;
}

/* —— E3 弹层字段行 —— */
.field {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 2rpx solid var(--c-border);
}
.field-label { width: 160rpx; color: var(--c-ink-2); font-size: var(--fs-body); }
.field-value { flex: 1; font-size: var(--fs-body); font-weight: 500; }
.field-arrow { color: var(--c-ink-3); }
.field-unit { color: var(--c-ink-2); font-size: var(--fs-body); }
.field-input { flex: 1; font-size: var(--fs-body); }
.field-ph { color: var(--c-ink-3); }
.sheet-note {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
  line-height: 1.7;
  margin-top: 28rpx;
}
