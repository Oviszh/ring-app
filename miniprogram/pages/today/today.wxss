.today-heading { display: flex; justify-content: space-between; align-items: center; margin: 12rpx 4rpx 32rpx; }
.saved-mark { display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; color: var(--c-ink-2); }
.saved-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--c-primary); }
.counter-card { padding: 24rpx 32rpx 32rpx; }
.counter-top { display: flex; align-items: center; justify-content: space-between; }
.counter-label { font-size: 26rpx; color: var(--c-ink-2); letter-spacing: 2rpx; }
.switch-controls { display: flex; gap: 12rpx; }
.switch-controls .switch-arrow { flex: none; width: 76rpx; min-width: 76rpx; height: 76rpx; line-height: 68rpx; padding: 0; border-radius: 50%; background: var(--c-bg); color: var(--c-primary); font-size: 42rpx; }
.switch-arrow[disabled] { color: #B5BEB4; background: var(--c-bg); }
.counter-name { font-family: 'Songti SC', 'STSong', serif; font-size: 42rpx; font-weight: 600; letter-spacing: 2rpx; margin-top: 8rpx; overflow-wrap: break-word; }
.counter-value { display: flex; align-items: baseline; padding: 8rpx 0 0; }
.counter-number { font-size: 120rpx; font-weight: 400; line-height: 1.25; font-variant-numeric: tabular-nums; letter-spacing: -4rpx; overflow-wrap: anywhere; }
.counter-unit { color: var(--c-ink-2); font-size: 28rpx; margin-left: 18rpx; flex-shrink: 0; }
.counter-meta { display: flex; justify-content: space-between; gap: 12rpx; color: var(--c-ink-2); font-size: 26rpx; padding-bottom: 24rpx; }
.counter-actions { border-top: 1rpx solid var(--c-border); padding-top: 28rpx; }
.counter-reminder { color: var(--c-primary); background: var(--c-bg); font-size: 26rpx; padding: 12rpx 16rpx; margin-bottom: 24rpx; border-radius: 10rpx; }
.list-heading { display: flex; justify-content: space-between; align-items: center; margin: 28rpx 0 12rpx; }
.list-heading-title { font-size: 34rpx; font-weight: 600; }
.today-page .text-button { width: auto; margin: 0; font-size: 28rpx; background: transparent; color: var(--c-primary); line-height: 80rpx; padding: 0 8rpx 0 24rpx; }
.practice-list { background: #fff; border: 1rpx solid var(--c-border); border-radius: 24rpx; padding: 0 28rpx; }
.practice-row { display: flex; align-items: center; min-height: 156rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--c-border); gap: 24rpx; }
.practice-row:last-child { border-bottom: none; }
.practice-info { flex: 1; min-width: 0; }
.practice-name { font-size: 32rpx; font-weight: 500; overflow-wrap: break-word; }
.practice-target { color: var(--c-ink-2); font-size: 24rpx; margin-top: 8rpx; }
.done-label { color: var(--c-primary); }
.practice-progress { margin-top: 14rpx; max-width: 300rpx; height: 6rpx; }
.practice-total { text-align: right; flex-shrink: 0; }
.practice-number { font-size: 40rpx; line-height: 1.3; font-variant-numeric: tabular-nums; }
.practice-unit { font-size: 24rpx; color: var(--c-ink-2); }
.practice-chevron { color: var(--c-ink-3); font-size: 34rpx; }
.add-practice { width: 100%; margin-top: 20rpx; line-height: 96rpx; color: var(--c-primary); background: transparent; font-size: 30rpx; }
.practice-hover { opacity: .7; }
.welcome { margin-top: 64rpx; padding: 64rpx 40rpx 40rpx; }
.welcome-rule { width: 48rpx; height: 4rpx; background: #A18D67; margin-bottom: 40rpx; }
.welcome-title { font-size: 44rpx; font-family: 'Songti SC', 'STSong', serif; font-weight: 600; }
.welcome-description { white-space: pre-line; color: var(--c-ink-2); font-size: 30rpx; margin: 24rpx 0 48rpx; line-height: 1.9; }
.welcome-button { width: 100%; }
.secondary-welcome { margin-top: 20rpx; }
.welcome-foot { text-align: center; color: var(--c-ink-2); font-size: 26rpx; margin-top: 36rpx; }
.manual-title { font-size: 38rpx; font-family: 'Songti SC', 'STSong', serif; }
.manual-card .btn { margin-top: 32rpx; width: 100%; }
.counter-shell { margin-bottom: 12rpx; background: #fff; border: 1rpx solid var(--c-border); border-radius: 24rpx; overflow: hidden; box-shadow: 0 6rpx 18rpx rgba(45,61,44,.04); }
.counter-shell.has-tabs .counter-card { padding-bottom: 12rpx; }
.counter-name { margin: 12rpx 0 28rpx; text-align: center; }
.counter-screen { background: #EAEFDF; border: 1rpx solid #D7DECD; border-radius: 16rpx; padding: 18rpx 24rpx 24rpx; box-shadow: inset 0 2rpx 5rpx rgba(38,57,32,.05); }
.screen-caption { display: flex; justify-content: space-between; margin-bottom: 20rpx; font-size: 24rpx; color: #596A50; }
.counter-meta { padding: 20rpx 0 22rpx; font-size: 24rpx; }
.unbound-status { text-align: center; padding: 18rpx 0 24rpx; }.unbound-title { font-size: 32rpx; font-weight: 500; }.unbound-description { font-size: 26rpx; color: var(--c-ink-2); margin-top: 6rpx; }
.device-status { font-size: 24rpx; color: var(--c-ink-2); margin: -8rpx 0 20rpx; text-align: center; }
.counter-actions { padding-top: 24rpx; }.device-tools { display: flex; margin-top: 16rpx; }.device-tools view { flex: 1; text-align: center; padding: 18rpx 4rpx 0; color: var(--c-primary); font-size: 26rpx; min-height: 72rpx; }
.count-tabs { display: flex; padding: 0 24rpx 4rpx; }
.count-tab { position: relative; flex: 1; height: 104rpx; line-height: 84rpx; text-align: center; color: var(--c-ink-2); font-size: 32rpx; letter-spacing: 2rpx; }
.count-tab.on { color: var(--c-primary); font-weight: 600; }
.count-tab.on::after { content: ''; position: absolute; width: 56rpx; height: 6rpx; background: var(--c-primary); border-radius: 3rpx; bottom: 12rpx; left: calc(50% - 28rpx); }
.count-tab:active { background: var(--c-bg); border-radius: 12rpx; }
.manual-settings { text-align: center; color: var(--c-primary); font-size: 26rpx; padding: 24rpx 0 0; }
.list-empty { background: #fff; border: 1rpx solid var(--c-border); border-radius: 24rpx; padding: 36rpx 28rpx; font-size: 28rpx; color: var(--c-ink-2); }
.practice-group { margin-bottom: 28rpx; }
.group-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 8rpx 4rpx 14rpx; color: var(--c-primary); font-size: 30rpx; font-weight: 600; }
.group-heading::before { content: ''; width: 6rpx; height: 28rpx; background: var(--c-primary); border-radius: 3rpx; }
.group-heading > text:first-child { flex: 1; }
.group-note { font-size: 24rpx; font-weight: 400; color: var(--c-ink-2); }
.group-main .practice-list { border-color: #C9D5C9; }
.group-common .group-heading { color: var(--c-ink-2); }.group-common .group-heading::before { background: #A6B0A3; }
.group-common .practice-list { background: #F0F2EC; }.group-common .practice-name { font-weight: 400; }
