.page {
  padding: var(--space);
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

/* —— 通用按钮 —— */

.btn-primary,
.btn-secondary {
  height: var(--btn-height);
  line-height: var(--btn-height);
  margin: 0;
  padding: 0 20rpx;
  font-size: var(--fs-body);
  font-weight: 600;
  border-radius: var(--radius);
  text-align: center;
  box-sizing: border-box;
}

.btn-primary {
  color: #fff;
  background: var(--c-primary);
}

.btn-secondary {
  color: var(--c-primary);
  background: var(--c-card);
  border: 2rpx solid var(--c-primary);
  box-sizing: border-box;
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

/* —— 空状态 P1-F —— */

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx var(--space);
}

.empty-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
  margin-bottom: 64rpx;
  text-align: center;
}

.empty-btn {
  width: 60%;
}

.empty-btn-second {
  margin-top: 20rpx;
}

/* —— LED 卡片 P1-E —— */

.led-card {
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  padding: var(--space);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-title);
  color: var(--c-primary);
  border-radius: 50%;
}

.switch-btn--disabled {
  color: var(--c-border);
}

.practice-name {
  flex: 1;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.led-num {
  margin-top: 16rpx;
  text-align: center;
  font-size: var(--fs-hero);
  line-height: 1.15;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--c-led);
  font-family: "DIN Alternate", "Courier New", monospace;
  text-shadow: 0 0 24rpx rgba(232, 116, 59, 0.35);
}

.led-caption {
  text-align: center;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.today-line {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-ink);
}

.led-enter {
  width: 100%;
  margin-top: var(--space);
}

.entry-link {
  margin-top: 12rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--c-primary);
}

/* —— P1-G 纯填报模式 —— */

.fill-card {
  padding: var(--space);
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  text-align: center;
}

.fill-title {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.6;
  color: var(--c-ink);
}

.fill-btn {
  width: 100%;
  margin-top: var(--space);
}

/* —— 我的功课 —— */

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 12rpx;
}

.section-title {
  font-size: var(--fs-body);
  font-weight: 600;
}

.section-action {
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
  padding: 12rpx;
}

.practice-row {
  display: flex;
  align-items: center;
  min-height: var(--btn-height);
  padding: 0 24rpx;
  margin-bottom: 12rpx;
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  box-sizing: border-box;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--c-border);
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
}

.dot--on {
  border-color: var(--c-primary);
  background: var(--c-primary);
}

.row-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-progress {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

.row-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--btn-height);
  font-size: var(--fs-body);
  color: var(--c-primary);
  border: 2rpx dashed var(--c-border);
  border-radius: var(--radius);
}

.foot-link {
  margin-top: 32rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--c-ink-secondary);
}

/* —— E3 填报弹层 —— */

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(43, 38, 32, 0.5);
}

.sheet {
  width: 100%;
  max-height: 90vh;
  padding: var(--space) var(--space) 48rpx;
  background: var(--c-card);
  border-radius: var(--radius) var(--radius) 0 0;
  box-sizing: border-box;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sheet-title {
  font-size: var(--fs-title);
  font-weight: 600;
}

.sheet-close {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: var(--fs-title);
  color: var(--c-ink-secondary);
}

.field {
  display: flex;
  align-items: center;
  min-height: var(--btn-height);
  border-bottom: 1rpx solid var(--c-border);
  box-sizing: border-box;
}

.field-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.field-value {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--c-ink);
}

.field-arrow {
  margin-left: 8rpx;
  color: var(--c-ink-secondary);
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-ink);
}

.amount-ph {
  font-size: var(--fs-small);
  font-weight: 400;
  color: var(--c-ink-secondary);
  opacity: 0.7;
}

.field-unit {
  width: 70rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.sheet-btns {
  display: flex;
  margin-top: 40rpx;
}

.sheet-btns .btn-primary,
.sheet-btns .btn-secondary {
  flex: 1;
}

.sheet-btns .btn-primary {
  margin-right: 20rpx;
}

.sheet-note {
  margin-top: 32rpx;
  font-size: var(--fs-small);
  line-height: 1.6;
  color: var(--c-ink-secondary);
}

.home-heading { display:flex; justify-content:space-between; align-items:center; }
.seal { width:72rpx; height:84rpx; line-height:84rpx; text-align:center; border:1rpx solid #9D8B64; border-radius:10rpx; color:#89754D; font-family:serif; font-size:36rpx; margin-right:8rpx; }
.empty-wrap { padding:40rpx 16rpx 48rpx; }
.enso { width:240rpx; height:240rpx; border:3rpx solid #9DAF9D; border-right-color:transparent; border-radius:50%; display:flex; justify-content:center; align-items:center; margin:12rpx 0 48rpx; transform:rotate(-25deg); }
.enso-core { width:184rpx; height:184rpx; border:1rpx solid #D6DDD0; border-left-color:transparent; border-radius:50%; }
.empty-title { font-family:'Songti SC',serif; font-size:42rpx; font-weight:500; letter-spacing:3rpx; }
.empty-sub { font-size:30rpx; line-height:2; white-space:pre-line; margin-top:12rpx; margin-bottom:44rpx; }
.empty-btn { width:100%; border-radius:20rpx; }
.empty-btn-second { margin-top:16rpx; }
.led-card { padding:28rpx 32rpx 12rpx; background:#E8EDE5; border:none; }
.practice-name { font-family:'Songti SC',serif; font-size:40rpx; font-weight:600; }
.switch-btn { font-size:52rpx; width:68rpx; }
.led-num { font-family:-apple-system,BlinkMacSystemFont,sans-serif; font-size:120rpx; font-weight:400; letter-spacing:-4rpx; text-shadow:none; margin:12rpx 0; overflow-wrap:anywhere; }
.today-line { font-size:28rpx; font-weight:400; margin-top:20rpx; }
.led-enter { border-radius:20rpx; margin-top:36rpx; }
.section { margin-top:44rpx; }
.section-head { padding:0 0 16rpx; }
.section-title { font-size:36rpx; }
.practice-row { min-height:144rpx; padding:24rpx; border:none; margin-bottom:16rpx; }
.practice-main { flex:1; min-width:0; }
.row-name { font-size:34rpx; white-space:normal; }
.row-progress { margin:6rpx 0 0; font-size:28rpx; }
.mini-track { height:4rpx; background:#E8EDE5; border-radius:4rpx; margin-top:16rpx; }
.mini-fill { height:100%; background:#87997B; border-radius:4rpx; }
.dot { width:12rpx; height:12rpx; margin-right:20rpx; }
.add-row { border:1rpx solid #DEE2D8; font-size:30rpx; }
.sheet { overflow-y:auto; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }
