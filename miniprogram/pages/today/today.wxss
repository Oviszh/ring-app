/* 今日页（样板页）——设计系统 v3 */

/* —— 空状态 —— */
.empty-mark {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #2E241B 0%, #4A3826 100%);
  color: #F7D9A8;
  font-size: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 44rpx;
  box-shadow: 0 12rpx 32rpx rgba(46, 36, 27, 0.25);
}

/* —— 主视觉计数卡（深咖烛光） —— */
.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-arrow {
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 52rpx;
  color: var(--c-hero-num);
  border-radius: 50%;
}
.hero-arrow:active { background: rgba(247, 217, 168, 0.14); }
.hero-arrow.off { color: rgba(243, 231, 211, 0.25); }

.hero-name {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-hero-text);
  flex: 1;
  text-align: center;
  letter-spacing: 2rpx;
}

.hero-num {
  font-size: var(--fs-hero);
  font-weight: 200;
  letter-spacing: 4rpx;
  color: var(--c-hero-num);
  text-align: center;
  margin: 40rpx 0 4rpx;
  font-variant-numeric: tabular-nums;
}
.hero-num.dim { color: rgba(247, 217, 168, 0.35); }

.hero-caption {
  font-size: var(--fs-small);
  color: var(--c-hero-sub);
  text-align: center;
  letter-spacing: 2rpx;
}

.hero-divider {
  height: 2rpx;
  background: rgba(243, 231, 211, 0.16);
  margin: 28rpx 0 20rpx;
}

.hero-today {
  font-size: var(--fs-small);
  color: var(--c-hero-sub);
  text-align: center;
}

.hero-actions { margin-top: 32rpx; }

/* 深咖卡上的烛光按钮 */
.btn-hero {
  background: linear-gradient(135deg, #F0C68C 0%, #D9A45E 100%);
  color: #3A2B1A;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.25);
}
.btn-hero:active { opacity: 0.88; }

.hero-ring-bar {
  display: flex;
  margin-top: 28rpx;
  border-top: 2rpx solid rgba(243, 231, 211, 0.16);
  padding-top: 24rpx;
}
.hero-ring-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--c-hero-sub);
  padding: 8rpx 0;
}
.hero-ring-item:first-child { border-right: 2rpx solid rgba(243, 231, 211, 0.16); }

/* —— 填报入口 —— */
.entry-link {
  text-align: center;
  color: var(--c-primary);
  font-size: var(--fs-body);
  font-weight: 600;
  padding: 28rpx 0 12rpx;
}

/* —— 功课列表 —— */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--c-track);
  margin-right: 22rpx;
  flex-shrink: 0;
}
.dot-on { background: var(--c-primary); }

.mini-track {
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--c-track);
  margin-top: 12rpx;
  overflow: hidden;
}
.mini-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--c-primary);
}

.add-row { justify-content: center; }
.add-text {
  text-align: center;
  color: var(--c-primary);
  font-size: var(--fs-body);
  font-weight: 600;
}

/* —— 纯填报模式 —— */
.fill-hero { text-align: center; padding: 60rpx 36rpx; }
.fill-title { font-size: var(--fs-body); color: var(--c-ink-2); margin-bottom: 40rpx; }
.foot-link {
  text-align: center;
  color: var(--c-ink-2);
  font-size: var(--fs-small);
  padding: 24rpx 0;
}

/* —— E3 弹层字段行 —— */
.field {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 2rpx solid var(--c-border);
}
.field-label { width: 170rpx; color: var(--c-ink-2); font-size: var(--fs-body); }
.field-value { flex: 1; font-size: var(--fs-body); font-weight: 600; }
.field-arrow { color: var(--c-ink-3); }
.field-unit { color: var(--c-ink-2); font-size: var(--fs-body); }
.field-input { flex: 1; font-size: var(--fs-body); }
.field-ph { color: var(--c-ink-3); }
.sheet-note {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
  line-height: 1.7;
  margin-top: 28rpx;
}
