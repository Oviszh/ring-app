/* P11 新建 / 修改大愿 —— 基于 app.wxss 设计系统 v2 */

.form-page { padding-bottom: 220rpx; }

.form-card { padding-top: 8rpx; padding-bottom: 8rpx; }

picker { display: block; }

/* —— 表单行：左标签、右控件 —— */
.row {
  padding: 24rpx 4rpx;
  border-bottom: none;
}

.f-label {
  flex: none;
  width: 190rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

.f-value {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 500;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.f-value.muted { color: var(--c-ink-2); font-weight: 400; }

.f-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 44rpx;
  font-weight: 600;
  text-align: right;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}
.f-input-text { font-size: var(--fs-body); font-weight: 500; }

.f-ph {
  font-size: var(--fs-small);
  font-weight: 400;
  color: var(--c-ink-3);
}

.f-unit {
  flex: none;
  margin-left: 12rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-2);
}

/* —— 二级日期选择 —— */
.sub-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  margin: 0 0 16rpx;
  padding: 0 24rpx;
  background: var(--c-bg);
  border-radius: var(--radius-sm);
}

/* —— 说明文字 —— */
.note {
  padding: 0 4rpx 18rpx 190rpx;
  font-size: var(--fs-mini);
  line-height: 1.6;
  color: var(--c-ink-2);
}

.note-strong {
  color: var(--c-primary);
  font-weight: 500;
}

.foot-note {
  padding: 8rpx 16rpx 0;
  text-align: center;
  font-size: var(--fs-mini);
  line-height: 1.7;
  color: var(--c-ink-2);
}

/* —— 置底提交 —— */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 245, 242, 0.96);
  box-shadow: 0 -2rpx 16rpx rgba(27, 25, 23, 0.06);
}

/* —— 空态 —— */
.empty-mark {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-btn { width: 60%; }
