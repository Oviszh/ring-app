<view class="page form-page">
  <view wx:if="{{noPractices}}" class="empty">
    <view class="empty-title">先添加一项功课</view>
    <view class="empty-sub">再为它设定一个长期目标。</view>
    <button class="btn btn-primary empty-btn" bindtap="goPracticeAdd">添加功课</button>
  </view>
  <block wx:elif="{{ready}}">
    <view class="page-heading"><view class="eyebrow">长期大愿</view><view class="page-title">{{isEdit ? '修改愿心' : '为日常修行立愿'}}</view><view class="page-description">从开始日期起，记录自动计入进度。</view></view>
    <view class="card form-card">
      <picker wx:if="{{!isEdit}}" range="{{practices}}" range-key="name" value="{{practiceIndex}}" bindchange="onPracticeChange"><view class="row"><view class="f-label">功课</view><view class="f-value">{{practiceName}}</view><text class="row-arrow">›</text></view></picker>
      <view wx:else class="row"><view class="f-label">功课</view><view class="f-value">{{practiceName}}</view></view>
      <view class="row"><view class="f-label">总目标</view><input class="f-input" type="number" maxlength="12" value="{{target}}" placeholder="填写数量" placeholder-class="f-ph" bindinput="onTargetInput" /><text class="f-unit">{{unit}}</text></view>
      <view class="row"><view class="f-label">名称</view><input class="f-input f-input-text" maxlength="24" value="{{name}}" placeholder="为这个大愿起个名字" placeholder-class="f-ph" bindinput="onNameInput" /></view>
    </view>
    <view class="section-title">从何时开始累计</view>
    <view class="card form-card">
      <picker wx:if="{{!isEdit}}" range="{{startOptions}}" value="{{startIndex}}" bindchange="onStartChange"><view class="row"><view class="f-label">开始日期</view><view class="f-value">{{startText}}</view><text class="row-arrow">›</text></view></picker>
      <view wx:else class="row"><view class="f-label">开始日期</view><view class="f-value muted">{{startDate}}</view></view>
      <picker wx:if="{{!isEdit && startIndex === 2}}" mode="date" value="{{startDate}}" end="{{today}}" bindchange="onPastDateChange"><view class="sub-row"><view class="f-label">选择日期</view><view class="f-value">{{startDate}}</view><text class="row-arrow">›</text></view></picker>
      <view class="row"><view class="f-label">已有累计</view><input class="f-input" type="number" maxlength="12" value="{{existingTotal}}" placeholder="0" placeholder-class="f-ph" bindinput="onExistingInput" /><text class="f-unit">{{unit}}</text></view>
      <view class="form-help">已有累计可填写开始日期之前完成的数量，避免与小程序记录重复计算。</view>
    </view>
    <view class="section-title">完成期限（选填）</view>
    <view class="card form-card">
      <picker range="{{deadlineOptions}}" value="{{deadlineIndex}}" bindchange="onDeadlineChange"><view class="row"><view class="f-label">期限</view><view class="f-value">{{deadlineText}}</view><text class="row-arrow">›</text></view></picker>
      <picker wx:if="{{showDeadlinePicker}}" mode="date" value="{{deadline}}" start="{{startDate}}" bindchange="onDeadlineDateChange"><view class="sub-row"><view class="f-label">截止日期</view><view class="f-value">{{deadline}}</view><text class="row-arrow">›</text></view></picker>
      <view wx:if="{{dailyHint}}" class="form-help strong">{{dailyHint}}</view>
    </view>
    <view class="foot-note">大愿与每日目标分别记录。</view>
  </block>
  <view wx:if="{{ready}}" class="submit-bar"><button class="btn btn-primary" disabled="{{submitting}}" bindtap="onSubmit">{{submitText}}</button></view>
</view>
