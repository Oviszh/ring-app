/* P15 计数汇总 —— 基于 app.wxss 设计系统 v2 */

.sum-card { padding: 36rpx 32rpx 32rpx; }

.sum-name {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.sum-hero {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.sum-total {
  font-size: var(--fs-big);
  font-weight: 300;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.sum-badge {
  margin-left: 18rpx;
  font-size: var(--fs-small);
  padding: 6rpx 20rpx;
}

.sum-sources {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--c-border);
}

.src {
  display: flex;
  align-items: baseline;
  margin: 0 36rpx 6rpx 0;
}

.src-label {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
  margin-right: 8rpx;
}

.src-val {
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

/* —— 空态 —— */
.empty-mark {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--c-primary-weak);
  color: var(--c-primary);
  font-size: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-btn { width: 60%; }
