/* P15 计数汇总：大字号、清晰分栏 */
.page {
  padding: var(--space) var(--space) 64rpx;
  box-sizing: border-box;
}

.list {
  background: var(--c-card);
  border: 1rpx solid var(--c-border);
  border-radius: var(--radius);
  overflow: hidden;
}

.row {
  padding: 28rpx var(--space);
  border-bottom: 1rpx solid var(--c-border);
}

.row:last-child {
  border-bottom: none;
}

.row-name {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.row-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.total {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-ink);
}

.sep {
  margin: 0 10rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.sub {
  font-size: var(--fs-body);
  color: var(--c-ink-secondary);
}

.row-sources {
  margin-top: 8rpx;
  font-size: var(--fs-small);
  line-height: 1.6;
  color: var(--c-ink-secondary);
}

/* —— 空态 —— */

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx var(--space);
}

.empty-title {
  font-size: var(--fs-title);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--c-ink-secondary);
  text-align: center;
}

.empty-link {
  margin-top: 40rpx;
  min-height: var(--btn-height);
  line-height: var(--btn-height);
  padding: 0 40rpx;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-primary);
  border-radius: var(--radius);
}

.empty-link-hover {
  background: var(--c-primary-weak);
}

/* 沉静的留白、细分隔与统一操作尺寸。 */
.card,.list { border-color:#E2E5DC; box-shadow:none; }
.btn-main,.btn-primary,.btn-save,.card-btn { border-radius:20rpx; font-weight:500; }
.sheet { max-height:85vh; overflow-y:auto; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); }
.sheet-close { min-width:72rpx; min-height:72rpx; text-align:center; line-height:72rpx; }
