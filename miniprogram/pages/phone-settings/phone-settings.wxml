<!-- P6 触屏计数设置：音效 / 音效选择 / 震动 / 外观 / 撤销确认 -->
<view class="page">

  <view class="section-title">计数体验</view>
  <view class="card">
    <view class="row">
      <view class="row-main">
        <view class="row-title">音效</view>
        <view class="row-sub">每计数一次播放提示音</view>
      </view>
      <switch class="switch" checked="{{sound}}" color="#344F42" bindchange="onSoundChange" />
    </view>

    <view class="row">
      <view class="row-main">
        <view class="row-title">音效选择</view>
      </view>
      <picker
        class="picker"
        mode="selector"
        range="{{soundOptions}}"
        range-key="name"
        value="{{soundIndex}}"
        bindchange="onSoundNameChange"
      >
        <view class="pick">
          <text class="pick-value">{{soundName}}</text>
          <text class="pick-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="row">
      <view class="row-main">
        <view class="row-title">震动反馈</view>
      </view>
      <switch class="switch" checked="{{vibrate}}" color="#344F42" bindchange="onVibrateChange" />
    </view>

    <view class="row">
      <view class="row-main">
        <view class="row-title">计数图案</view>
      </view>
      <picker
        class="picker"
        mode="selector"
        range="{{themeOptions}}"
        range-key="name"
        value="{{themeIndex}}"
        bindchange="onThemeChange"
      >
        <view class="pick">
          <text class="pick-value">{{themeName}}</text>
          <text class="pick-arrow">›</text>
        </view>
      </picker>
    </view>


  </view>

  <view class="note">音效和震动用于手机点按计数，可按习惯独立设置。</view>
</view>
