/* P6 手机计数设置 —— 基于 app.wxss 设计系统 */

.switch {
  flex: none;
  margin-left: 16rpx;
  transform: scale(1.1);
  transform-origin: right center;
}

/* —— 右侧选择 —— */
.picker {
  flex: none;
  max-width: 55%;
}

.pick {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 88rpx;
  padding-left: 16rpx;
}

.pick-value {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--c-primary);
  white-space: nowrap;
}

.pick-arrow {
  margin-left: 12rpx;
  font-size: var(--fs-body);
  color: var(--c-ink-3);
}

.note {
  padding: 8rpx 8rpx 0;
  font-size: var(--fs-small);
  line-height: 1.7;
  color: var(--c-ink-2);
}
