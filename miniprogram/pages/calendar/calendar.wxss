/* P1' 日历（月视图）——基于 app.wxss 设计系统 v2 */

.page-cap {
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
  letter-spacing: 2rpx;
  margin: 4rpx 4rpx 12rpx;
}

/* —— 月份切换 —— */

.month-bar {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.month-arrow {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: var(--fs-big);
  color: var(--c-primary);
  border-radius: 50%;
}
.month-arrow:active { background: var(--c-primary-weak); }
.month-arrow.off { color: var(--c-ink-3); }
.month-arrow.off:active { background: transparent; }

.month-label {
  flex: 1;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-ink);
}

/* —— 查看口径 —— */

.view-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.chips { flex: 0 1 auto; min-width: 0; }

.chip-view {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 460rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.chip-text {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chip-arrow {
  margin-left: 12rpx;
  font-size: var(--fs-mini);
  opacity: 0.7;
}

.view-target {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-primary);
}

/* —— 月历网格 —— */

.cal-card {
  padding: 16rpx 12rpx;
  margin-bottom: 16rpx;
}

.week-row {
  display: flex;
  padding: 4rpx 0 10rpx;
}

.week-cell {
  width: 14.2857%;
  text-align: center;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 14.2857%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.cell-mark.on { border-color: var(--c-primary); }

.cell-day {
  font-size: 32rpx;
  line-height: 1.1;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}

.cell-day-mini {
  font-size: 20rpx;
  line-height: 1.1;
  color: var(--c-ink-3);
}

.cell-num {
  font-size: 26rpx;
  line-height: 1.15;
  font-weight: 600;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
}
.cell-num.warn { color: var(--c-warn); }

.dim { color: var(--c-ink-3); }

/* 状态点：● 达标 / ◐ 部分 / ○ 未完成 / · 无数据 */
.cell-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-top: 4rpx;
  box-sizing: border-box;
}
.dot-met { background: var(--c-success); }
.dot-partial {
  background: linear-gradient(to right, var(--c-warn) 50%, var(--c-track) 50%);
}
.dot-missed {
  background: transparent;
  border: 3rpx solid var(--c-ink-3);
}
.dot-none { background: var(--c-track); }

/* —— 图例 / 统计 —— */

.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin: 4rpx 0 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}
.legend-item .cell-dot { margin: 0 10rpx 0 0; }

.stats {
  margin: 4rpx 0 8rpx;
  text-align: center;
  font-size: var(--fs-small);
  color: var(--c-ink-2);
}

/* —— 长期大愿 —— */

.vow-card { padding: 28rpx 32rpx; }

.vow-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.vow-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--c-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.vow-pct {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: var(--fs-small);
  font-weight: 600;
  color: var(--c-primary);
}

.vow-track { margin-top: 20rpx; }

.vow-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: var(--fs-mini);
  color: var(--c-ink-2);
}

.vow-count { font-variant-numeric: tabular-nums; }
.vow-sub { margin-left: 20rpx; }

.vow-empty {
  text-align: center;
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--c-primary);
  border: 2rpx dashed var(--c-border);
  box-shadow: none;
  background: transparent;
  padding: 44rpx 32rpx;
}
